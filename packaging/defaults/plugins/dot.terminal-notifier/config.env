# dot.terminal-notifier (herdr-terminal-notifier) settings.
#
# Sourced by bin/notify.sh via lib/config.sh. Resolution order, later wins:
#   1. built-in default (lib/config.sh)
#   2. environment variable
#   3. $HERDR_PLUGIN_CONFIG_DIR/config.env   <- this file
#   4. $HERDR_TN_CONFIG
#
# This file lives in herdr's per-machine plugin config dir, which the plugin
# installer never overwrites (unlike files inside the content-hashed install
# directory), so these settings survive plugin updates.

# Which NEW agent statuses notify. Valid: working blocked idle done unknown
TRIGGER_STATUSES="blocked done"

# Stay quiet for the workspace you are currently looking at.
#
# 0 (NOT the plugin default of 1): notify even when the changed workspace is the
# one focused inside herdr and a terminal is frontmost. With the default of 1,
# every blocked/done in the workspace you are looking at is dropped -- and since
# all agents here live in a single workspace, that suppressed essentially every
# notification. The plugin's own reason for the default is the inverse case
# (don't notify for what you are already watching), which is the wrong trade-off
# here; DEBOUNCE_SECONDS below keeps it from becoming spam.
SUPPRESS_FOCUSED=0

# Bundle ids of terminal apps that host herdr, for the frontmost check above.
# Inert while SUPPRESS_FOCUSED=0, kept for if it is re-enabled.
TERMINAL_APP_IDS="app.mash.ghostty com.mitchellh.ghostty com.apple.Terminal com.googlecode.iterm2 net.kovidgoyal.kitty com.github.wez.wezterm org.alacritty"

# Drop a repeated (pane,status) seen within this many seconds (flap guard).
# Raised from the default of 2: with SUPPRESS_FOCUSED=0 the same workspace now
# notifies while you are watching it, so a slightly wider window absorbs the
# rapid working->blocked->done churn without hiding distinct transitions.
DEBOUNCE_SECONDS=5

# Delete per-pane state files (laststatus-*/debounce-*) older than this many days.
STATE_SWEEP_DAYS=7

# Click the notification to jump to the agent that changed.
ACTIVATE_ON_CLICK=1

# Click target. {pane}/{workspace}/{agent} are substituted before running
# `herdr <CLICK_COMMAND>`.
CLICK_COMMAND="agent focus {pane}"

# Per-status templates. {agent} {workspace} {worktree} {tab} {tab_label}
# {title} {pane} {session} {cwd} {old_status} {new_status} are expanded.
TITLE_BLOCKED="{agent}: blocked"
BODY_BLOCKED="{title} · {workspace}"
TITLE_DONE="{agent}: done"
BODY_DONE="{title} · {workspace}"
