# Auto Title configuration, read once when the plugin starts. Mash points
# XDG_CONFIG_HOME at ~/.mash/config, so this is the file Auto Title finds.
# Every setting it accepts is listed in the plugin's config.env.example.

# Keep the agent's name in front of what it is doing ("pi › Fix auth"). Auto
# Title 0.13 turned this off by default; Mash keeps the titles it always had.
HERDR_AUTO_TITLE_AGENT_NAME=true
