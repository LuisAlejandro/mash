# Auto Title configuration, read once when the plugin starts. Mash points
# XDG_CONFIG_HOME at ~/.mash/config, so this is the file Auto Title finds, and
# it is editable: Mash ships these values and never writes over an edit.
#
# Every setting it accepts is listed in the plugin's config.env.example.

# Name a tab after the agent pane even while the editor beside it has focus.
# Without this the label follows whatever the user clicked last, so a dev tab
# reads "fresh" the moment the editor is touched.
HERDR_AUTO_TITLE_PREFER_AGENT=true

# Leave the agent's name out. Every tab in Mash holds an agent, so "pi › " in
# front of a name that already says what the work is costs columns and tells
# nobody anything.
HERDR_AUTO_TITLE_AGENT_NAME=false

# Leave the branch out. It says where the work sits, not what it is, and every
# tab of a repository would carry the same one.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Put a mark in front of a tab whose agent needs the user: "● 8 · fix the poll
# loop". Mash patches the plugin so only a blocked or finished agent is marked,
# and both carry the same ● — a mark that shows on most tabs means nothing.
HERDR_AUTO_TITLE_AGENT_STATUS=true
