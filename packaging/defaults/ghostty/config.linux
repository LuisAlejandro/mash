auto-update = off
title = "Mash Terminal"

# What the window runs. Mash has one window, and its program comes from here
# alone: the launcher execs the terminal without -e, so this is the only thing
# that makes the window Mash rather than a bare shell.
# __MASH_HERDR_PANE__ is substituted at first launch: the path depends on the
# install prefix.
command = __MASH_HERDR_PANE__

# Where the window starts. This is the directory Herdr gives the first
# workspace when none is saved yet, so an unset value would open it wherever
# the launcher ran.
#
# It matters more here than on macOS: Ghostty defaults to `home` only when it
# can DETECT a desktop-launcher start, and Mash's launcher execs the terminal
# from a shell script, where that detection can fall back to `inherit`.
working-directory = home

theme = Monokai Cursor

# Mash's identity on Linux. The macOS bundle gets these from its plist and its
# folder name; on Linux the Wayland app-id, WM_CLASS and DBus name all come from
# `class`, so it must match the desktop entry's StartupWMClass and the icon name
# the package installs, or GNOME shows a second, unassociated application.
class = "app.mash.Mash"
x11-instance-name = "mash-terminal"

# One window, one process. Opening Mash again reaches the running instance over
# D-Bus under `class` above, which brings its window forward instead of opening
# another. The id is Mash's own, so this never attaches to a personal Ghostty,
# and only the first launch's process runs a window, so a second launch's
# environment never reaches a pane.
gtk-single-instance = true

# Quit when the window closes, as on macOS. `-e` used to force this; Ghostty's
# Linux default is true as well, and stating it keeps the two platforms' config
# saying the same thing.
quit-after-last-window-closed = true

# Linux keymap. Ghostty on Linux does not receive the macOS Command chords, so
# this file releases the Ctrl chords that Ghostty would otherwise consume before
# Herdr or Fresh sees them, and leaves the rest of the stock keymap alone.
#
# The rule: Ghostty owns terminal-level behaviour (copy, paste, font size,
# scrollback); Herdr owns workspaces, tabs and panes; Fresh owns editing. A chord
# is released here only when something downstream actually binds it.

# Why these unbinds stay after Mash removed the features outright: a Ghostty
# binding that performs nothing still consumes its chord unless it carries the
# `performable:` prefix. The unbind is therefore what frees the key for Herdr
# and Fresh, not merely a way to suppress a Ghostty behaviour. Removing one
# restores the default binding and silently swallows the chord.

# Ctrl+Shift chords are the closest Linux equivalent of the macOS Command
# families Herdr uses, and GNOME leaves them alone.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+r=unbind
keybind = ctrl+shift+l=unbind
keybind = ctrl+shift+x=unbind
keybind = ctrl+shift+g=unbind
keybind = ctrl+shift+i=unbind

# Herdr's tab cycling and its settings/reload chords, on the keys Linux Cursor
# uses. Ghostty binds all four by default with set.put, not putFlags, so they
# are not `performable:`: previous_tab/next_tab are in mash_removed_ui and do
# nothing, open_config and reload_config run, and either way the chord stops
# here. The menu's Reload Configuration still reloads both Ghostty and Herdr.
# Ctrl+PgUp/PgDn need no unbind: those defaults are performable, so they fall
# through to Fresh's buffer switching.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+,=unbind
keybind = ctrl+shift+,=unbind
# Fresh's toggle_file_explorer, Cursor's explorer chord. Ghostty's default is
# new_split:down (set.put, in mash_removed_ui), which swallowed it.
keybind = ctrl+shift+e=unbind

# Ctrl+Shift+Up/Down carry Herdr's previous_agent / next_agent. Ghostty's own
# Linux defaults bind them to jump_to_prompt with set.put, not set.putFlags, so
# the binding is not `performable:` and consumes the chord even though
# src/Surface.zig rejects the action itself (mash_removed_ui: "Herdr keeps its
# own scrollback, so these chords belong to Herdr"). Unbinding is what frees
# them -- without it both the chord and the "Previous/Next Agent" menu items
# that send it went nowhere.
keybind = ctrl+shift+arrow_up=unbind
keybind = ctrl+shift+arrow_down=unbind

# Ctrl+Alt chords carry the pane family. Ghostty binds goto_split to all four
# ctrl+alt+arrows; goto_split is in mash_removed_ui too, and the binding still
# consumes the chord, so these unbinds stay load-bearing even though pane focus
# itself moved to ctrl+super (GNOME owns ctrl+alt+arrows).
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+w=unbind

# Let Fresh own the editing chords inside its panes. These are the ones Ghostty
# binds by default and would otherwise swallow.
keybind = ctrl+f=unbind
keybind = ctrl+g=unbind
keybind = ctrl+e=unbind
keybind = ctrl+a=unbind
keybind = ctrl+d=unbind
keybind = ctrl+z=unbind
keybind = ctrl+shift+z=unbind
keybind = ctrl+backslash=unbind
keybind = ctrl+shift+f=unbind

# Copy stays terminal-owned and performable: with a Ghostty selection Ctrl+Shift+C
# copies it, with none the chord falls through to Fresh and copies the buffer.
keybind = performable:ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard

# Font: the package installs MesloLGS NF into the system font tree, so naming it
# is enough and no fallback is needed.
font-family = "MesloLGS NF"
font-size = 10
font-feature = -liga, -calt, -dlig

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
