#!/bin/sh
# Open a Herdr tab running pi in a single pane.
# Bound to cmd+alt+t in Mash's Herdr config (config/herdr/config.toml) as a `shell` custom command.
#
# --label marks this tab for the dev-tab plugin's tab.created hook, which must
# skip it: this script wants a single pi pane, and the hook would otherwise
# enrich it into a fresh+pi split. Cleared below so Herdr resumes auto-naming.
set -eu

herdr="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$HOME}"
here="$(dirname "$0")"
# Fail before creating a tab if the bundled pi is missing: a host pi is not a
# valid fallback for Mash's pi launcher.
pi_cmd="$("$here/mash-bin" --bundled pi)" || exit 1

created="$("$herdr" tab create --label "herdr-tab-launcher-pi" \
	${HERDR_ACTIVE_WORKSPACE_ID:+--workspace "$HERDR_ACTIVE_WORKSPACE_ID"} \
	--cwd "$cwd" --focus)"
tab="$(printf '%s' "$created" | "$here/herdr-json" tab_id)"
pane="$(printf '%s' "$created" | "$here/herdr-json" pane_id)"

# Start pi as a tracked agent; herdr-agent-start owns the tracked-vs-untracked
# rationale and the absolute-path fallback. Its stdout is the agent name, for
# callers that then focus it -- this tab is created focused, so discard it.
"$here/herdr-agent-start" "$pane" pi pi "$pi_cmd" >/dev/null
[ -n "$tab" ] && "$herdr" tab rename "$tab" "" || true
