#!/bin/sh
# Open a Herdr tab running pi in a single pane.
# Bound to cmd+alt+t in ~/.config/herdr/config.toml as a `shell` custom command.
#
# --label marks this tab for the dev-tab plugin's tab.created hook, which must
# skip it: this script wants a single pi pane, and the hook would otherwise
# enrich it into a fresh+pi split. Cleared below so Herdr resumes auto-naming.
set -eu

herdr="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$HOME}"
here="$(dirname "$0")"

# Start pi as a TRACKED agent (herdr agent start) rather than just running the
# binary (herdr pane run). Tracked means Herdr knows the pane holds an agent:
# real idle/working/blocked status in the sidebar, and `herdr agent prompt
# <name>` can drive it. Name comes from herdr-agent-name, which matches the
# herdr-workspace plugin's "<workspace-slug>-<role>" scheme and resolves
# collisions, since these launchers are pressed repeatedly.
#
# agent start is best-effort: it waits for the agent to become interactive and
# fails if the name is taken or pi never gets ready. A failure there must not
# cost the user the tab, so fall back to the old untracked `pane run`.
start_agent() {
	_pane="$1" _role="$2" _kind="$3" _cmd="$4"
	_name="$("$here/herdr-agent-name" "$_role" 2>/dev/null || true)"
	if [ -n "$_name" ] &&
		"$herdr" agent start "$_name" --kind "$_kind" --pane "$_pane" >/dev/null 2>&1; then
		return 0
	fi
	"$herdr" pane run "$_pane" "$_cmd"
}

created="$("$herdr" tab create --label "herdr-tab-launcher-pi" \
	${HERDR_ACTIVE_WORKSPACE_ID:+--workspace "$HERDR_ACTIVE_WORKSPACE_ID"} \
	--cwd "$cwd" --focus)"
tab="$(printf '%s' "$created" | sed -n 's/.*"tab_id":"\([^"]*\)".*/\1/p' | head -n 1)"
pane="$(printf '%s' "$created" | sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p' | head -n 1)"

start_agent "$pane" pi pi pi
[ -n "$tab" ] && "$herdr" tab rename "$tab" "" || true
