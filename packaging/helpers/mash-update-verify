#!/bin/bash
# Download and prepare the exact destination-volume candidate while Mash is
# usable. Only the detached worker may close Mash and exchange the bundles.
set -u
[ "$#" -ge 3 ] && [ "$#" -le 4 ] || exit 2
app="$1" candidate="$2" installed="$3" d="${4:-$HOME/.mash}"
[[ "$candidate" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 2
case "$app" in /*.app) ;; *) exit 2 ;; esac
[ -d "$app/Contents" ] && [ ! -L "$app" ] || exit 2
parent="$(cd "$(dirname "$app")" && pwd -L)" || exit 2
[ "$app" = "$parent/$(basename "$app")" ] && [ -w "$parent" ] || exit 2
bin="$(cd "$(dirname "$0")" && pwd)" || exit 2
# shellcheck source=mash-update-common
source "$bin/mash-update-common" || exit 1
mash_update_init "$d" || exit 1
for helper in mash-update-processes mash-update-gate mash-update-apply mash-update-swap; do
  [ -x "$bin/$helper" ] || { printf '  The updater is incomplete. Mash was not changed.\n'; exit 1; }
done
if mash_update_legacy_active; then
  printf '  An update is already running. Mash was not changed.\n'; exit 1
fi
work="$(mktemp -d "${TMPDIR:-/tmp}/mash-update-XXXXXX")" || exit 1
mnt="" sibling="" handed_off=0
cleanup() {
  local rc=$?
  [ "$handed_off" = 0 ] || return 0
  [ -z "$mnt" ] || hdiutil detach "$mnt" -quiet >>"$MU_STATE/mash-update.log" 2>&1 || true
  if [ -n "${MU_ID:-}" ] && [ "$(mash_update_read id)" = "$MU_ID" ]; then
    case "$(mash_update_read phase)" in
    preparing | ready) mash_update_finish cancelled || true ;;
    esac
  fi
  [ -z "$sibling" ] || rm -rf "$sibling"
  rm -rf "$work"
  return "$rc"
}
trap cleanup EXIT
if ! mash_update_begin "$app" "$candidate" "$installed" "$work"; then
  printf '  Another update is active or needs recovery. Mash was not changed.\n'; exit 1
fi
fail() {
  printf '  %s Mash was not changed.\n' "$1"
  mash_update_log "failure=$1"
  if [ "$(mash_update_read id)" = "$MU_ID" ]; then
    if [ "$(cat "$MU_STATE/update-notice" 2>/dev/null)" = "$candidate" ]; then
      rm -f "$MU_STATE/update-notice"
      printf '%s\n' "$candidate" >"$MU_STATE/update-retry"
    fi
    mash_update_finish failed-before-swap || true
  fi
  exit 1
}
team_of() { codesign -dv "$1" 2>&1 | sed -n 's/^TeamIdentifier=//p' | head -n 1; }
asset="Mash-$candidate-mac-arm64.dmg"
printf '  Downloading Mash %s...\n' "$candidate"
curl -fL --retry 2 --max-time 1800 --progress-bar -o "$work/$asset" \
  "https://github.com/LuisAlejandro/mash/releases/download/$candidate/$asset" || fail 'Download failed.'
printf '  Verifying the download...\n'
mnt="$work/mount"
mkdir -p "$mnt" || fail 'Could not prepare the image.'
if ! mash_update_run 60 mount hdiutil attach -nobrowse -readonly -mountpoint "$mnt" "$work/$asset"; then
  mnt=""; fail 'The download could not be opened.'
fi
[ -d "$mnt/Mash.app" ] || fail 'The download has no Mash.app.'
mash_update_run 600 signature codesign --verify --deep --strict "$mnt/Mash.app" || fail 'The download is not correctly signed.'
mash_update_run 600 gatekeeper spctl --assess --type execute "$mnt/Mash.app" || fail 'The download was rejected by Gatekeeper.'
want="$(team_of "$app")" got="$(team_of "$mnt/Mash.app")"
[ -n "$want" ] && [ "$want" != 'not set' ] && [ "$want" = "$got" ] || fail 'The download has a different signing Team ID.'
printf '  Preparing the final copy. Mash stays open during verification...\n'
sibling="$(mktemp -d "$parent/.mash-update-XXXXXX")" || fail 'Could not prepare the update beside Mash.'
printf '%s\n' "$MU_ID" >"$sibling/.mash-update-owner" || fail 'Could not record preparation ownership.'
mash_update_write sibling "$sibling" || fail 'Could not record the prepared location.'
staged="$sibling/Mash.app"
mash_update_run 1800 copy ditto "$mnt/Mash.app" "$staged" || fail 'The download could not be prepared.'
prepared=""
[ ! -f "$staged/Contents/Resources/VERSION" ] || read -r prepared <"$staged/Contents/Resources/VERSION" || true
[ "$prepared" = "$candidate" ] || fail 'The downloaded app has the wrong version.'
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$staged/Contents/Info.plist" 2>/dev/null)" = app.mash ] || fail 'The download is not Mash.'
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$staged/Contents/Info.plist" 2>/dev/null)" = "$candidate" ] &&
  [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$staged/Contents/Info.plist" 2>/dev/null)" = "$candidate" ] || fail 'The app version metadata disagrees.'
uuid="$("$bin/mash-update-processes" uuid "$staged/Contents/MacOS/mash-terminal")" || fail 'The application executable is unsupported.'
mash_update_run 600 prepared-signature codesign --verify --deep --strict "$staged" || fail 'The prepared app is not correctly signed.'
mash_update_run 600 prepared-gatekeeper spctl --assess --type execute "$staged" || fail 'The prepared app was rejected by Gatekeeper.'
[ "$(team_of "$staged")" = "$want" ] || fail 'The prepared app has a different signing Team ID.'
mash_update_run 60 detach hdiutil detach "$mnt" -quiet || fail 'Could not close the image.'
mnt=""
# Quarantine is removed only after signature and Gatekeeper acceptance.
xattr -dr com.apple.quarantine "$staged" >>"$MU_STATE/mash-update.log" 2>&1 || true
for helper in mash-update-common mash-update-processes mash-update-gate mash-update-apply mash-update-swap; do
  cp "$bin/$helper" "$work/$helper" || fail 'A detached helper could not be prepared.'
done
chmod 700 "$work"/mash-update-*
"$work/mash-update-processes" now >/dev/null || fail 'The detached worker cannot start.'
mash_update_write expected_uuid "$uuid" || fail 'Could not record the target build.'
mash_update_phase ready || fail 'Could not record preparation.'
printf '\n  Ready to install Mash %s (you have %s).\n' "$candidate" "$installed"
printf '  This closes Mash now and reopens it when done.\n'
printf '  Type y to install, anything else to cancel: '
IFS= read -r answer || answer=n
case "$answer" in y | Y | yes | YES) ;; *) printf '  Cancelled. Mash was not changed.\n'; exit 0 ;; esac
# Transfer cleanup ownership BEFORE bootstrap: the worker may stop this pane
# immediately. A parent killed after launching it must not delete its inputs.
handed_off=1
if ! mash_update_bootstrap "$work/mash-update-apply" --app "$staged" --dest "$app" \
  --data "$d" --work "$work" --version "$candidate" --attempt "$MU_ID"; then
  handed_off=0
  fail 'Could not start the update helper.'
fi
printf '\n  Installing. Mash will reopen after the new build is ready.\n'
exit 0
