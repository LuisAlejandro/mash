#!/usr/bin/env python3
"""Project only Mash's selected Pi model and API key into OpenDesign's Pi."""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

TARGET = "/home/open-design/.mash-pi-agent"


def selection(root: Path):
    agent = root / "pi/agent"
    for name in ("settings.json", "auth.json", "models.json"):
        if (agent / name).is_symlink():
            return None
    try:
        settings = json.loads((agent / "settings.json").read_text())
        credentials = json.loads((agent / "auth.json").read_text())
        provider = settings["defaultProvider"]
        model = settings["defaultModel"]
        credential = credentials[provider]
        if (not isinstance(provider, str) or not provider or
                not all(char.isascii() and (char.isalnum() or char in "_-") for char in provider) or
                not isinstance(model, str) or not model or any(char in model for char in "\r\n\t")):
            return None
        if credential.get("type") != "api_key" or not isinstance(credential.get("key"), str) or not credential["key"]:
            return None
        projected = {
            "settings.json": {"defaultProvider": provider, "defaultModel": model, "defaultThinkingLevel": "medium"},
            "auth.json": {provider: {"type": "api_key", "key": credential["key"]}},
        }
        if provider not in ("openai", "anthropic", "openrouter"):
            models = json.loads((agent / "models.json").read_text())
            entry = models["providers"][provider]
            if not isinstance(entry, dict) or not isinstance(entry.get("baseUrl"), str) or not isinstance(entry.get("api"), str):
                return None
            selected_models = [item for item in entry.get("models", []) if isinstance(item, dict) and item.get("id") == model]
            if not selected_models:
                return None
            projected["models.json"] = {"providers": {provider: {
                "baseUrl": entry["baseUrl"], "api": entry["api"], "models": selected_models[:1]
            }}}
        return provider, model, projected
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None


def write_env(path: Path, provider: str, model: str) -> None:
    if path.is_symlink():
        raise ValueError("refusing a symlink for OpenDesign config")
    original = path.read_text()
    settings = {
        "OPEN_DESIGN_RUN_AGENT": "pi",
        "OPEN_DESIGN_RUN_MODEL": f"{provider}/{model}",
        "MASH_DESIGN_PI_READY": "1",
    }
    lines = [line for line in original.splitlines() if line.split("=", 1)[0] not in settings]
    lines.extend(f"{key}={value}" for key, value in settings.items())
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as tmp:
        tmp.write("\n".join(lines) + "\n")
        name = Path(tmp.name)
    try:
        name.chmod(0o600)
        name.replace(path)
    finally:
        name.unlink(missing_ok=True)


def sync(root: Path, stack: Path, project: str) -> None:
    selected = selection(root)
    if not selected:
        raise ValueError("Mash Pi has no API-key provider and model to share")
    if stack.resolve() != (root / "local/share/mash/design").resolve():
        raise ValueError("OpenDesign stack is outside Mash data")
    env_file = stack / "penpot.env"
    if not env_file.is_file():
        raise ValueError("OpenDesign needs mds setup before Pi can be shared")
    provider, model, files = selected
    base = ["docker", "compose", "-p", project, "-f", str(stack / "docker-compose.yaml"), "--env-file", str(env_file)]

    def run(step: str, *args: str) -> None:
        result = subprocess.run([*base, *args], cwd=stack, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode:
            raise RuntimeError(f"OpenDesign Pi sync failed during {step}")

    # No Mash Pi sessions, extensions, or other credentials enter the container.
    # The container's own home volume is writable; Pi 0.87.1 takes file locks
    # beside settings.json/auth.json, so a read-only bind mount would not work.
    with tempfile.TemporaryDirectory(dir=root / "setup") as temp:
        directory = Path(temp)
        for filename, content in files.items():
            path = directory / filename
            path.write_text(json.dumps(content, indent=2) + "\n")
            path.chmod(0o600)
        run("directory creation", "exec", "-T", "-u", "root", "open-design", "install", "-d", "-m", "700", "-o", "1001", "-g", "1001", TARGET)
        for filename in files:
            dest = f"open-design:{TARGET}/{filename}"
            run("file copy", "cp", str(directory / filename), dest)
            run("file ownership", "exec", "-T", "-u", "root", "open-design", "chown", "1001:1001", f"{TARGET}/{filename}")
            run("private permissions", "exec", "-T", "-u", "root", "open-design", "chmod", "600", f"{TARGET}/{filename}")
    checked = subprocess.run([*base, "exec", "-T", "open-design", "pi", "--list-models", f"{provider}/{model}"],
                             cwd=stack, capture_output=True, text=True)
    if checked.returncode or not any(line.split()[:2] == [provider, model] for line in checked.stdout.splitlines()):
        raise RuntimeError("OpenDesign Pi does not list the configured model")
    write_env(env_file, provider, model)


if __name__ == "__main__":
    try:
        root = Path(os.environ.get("MASH_DATA_DIR") or Path.home() / ".mash")
        if len(sys.argv) == 2 and sys.argv[1] == "--configured":
            sys.exit(0 if selection(root) else 1)
        if len(sys.argv) != 3:
            raise ValueError("usage: mash-design-pi-sync STACK PROJECT")
        sync(root, Path(sys.argv[1]), sys.argv[2])
    except (OSError, ValueError, RuntimeError) as error:
        print(f"Mash OpenDesign Pi: {error}", file=sys.stderr)
        sys.exit(1)
