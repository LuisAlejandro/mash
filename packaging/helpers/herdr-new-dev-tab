#!/bin/sh
# Open a Herdr tab with two vertical panes: fresh (left) and pi (right).
# Bound to cmd+t in Mash's Herdr config (config/herdr/config.toml) as a `shell` custom command.
set -eu

herdr="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$HOME}"
here="$(dirname "$0")"

# The two-pane layout itself (fresh on the left, tracked pi agent on the right,
# split ratio, the load-bearing `.` argument that makes Fresh show its explorer)
# lives in bin/herdr-dev-tab-fill, shared with the "+" tab button's tab.created
# hook -- see that script. FRESH_RATIO passes through to it via the environment.

# --label marks this tab for the dev-tab plugin's tab.created hook, which must
# skip it: this script builds its own layout, and letting the hook enrich the
# same tab too would produce four panes. The label is cleared at the end so
# Herdr resumes auto-naming the tab from its focused pane -- which is pi, not
# fresh, because herdr-dev-tab-fill focuses pi once it is ready, e.g.
# "4 · pi › π - app".
created="$("$herdr" tab create --label "herdr-tab-launcher-dev" \
	${HERDR_ACTIVE_WORKSPACE_ID:+--workspace "$HERDR_ACTIVE_WORKSPACE_ID"} \
	--cwd "$cwd" --env MASH_DEV_TAB_FRESH=1 --focus)"
tab="$(printf '%s' "$created" | "$here/herdr-json" tab_id)"
left="$(printf '%s' "$created" | "$here/herdr-json" pane_id)"

# Fresh is already starting in the root pane; only the native "+" hook
# needs to type its command into an existing shell.
"$here/herdr-dev-tab-fill" "$left" --fresh-started

[ -n "$tab" ] && "$herdr" tab rename "$tab" "" || true
