#!/bin/bash
# Install the design stack's Python and npm dependencies into the data folder.
#
# These are not shipped in the bundle. They are only useful once the design
# stack is set up, and the largest of them (playwright) is 140 MB, so `mds`
# calls this when the stack is actually being set up rather than every launch.
#
# Idempotent: anything already present is skipped, so it is safe to re-run and
# safe to interrupt. Progress goes to <data>/setup/design-deps.log.
#
#   mash-design-deps [DATA_DIR]
set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)"
py="$self/../python/bin/python3"
# Absolute on purpose. The wizard runs this before mash_isolate, so PATH is
# whatever launched the app: a bare `npm` would find the host's, or none.
npm="$self/../node/bin/npm"
[ -x "$npm" ] || npm="$(command -v npm || true)"
# The bundled npm and pip shims are `#!/usr/bin/env node` and `env python3`, so
# they need Mash's own interpreters on PATH no matter who invoked this.
PATH="$(cd "$self/../node/bin" && pwd):$(cd "$self/../python/bin" && pwd):$PATH"
export PATH

data="${1:-${MASH_DATA_DIR:-}}"
if [ -z "$data" ] && [ -n "${PI_CODING_AGENT_DIR:-}" ]; then
  data="$(cd "$PI_CODING_AGENT_DIR/../.." 2>/dev/null && pwd)"
fi
[ -n "$data" ] || data="$HOME/.mash"

cfg="${MASH_CONFIG_DIR:-$data/config/mash}"
skills="${PI_CODING_AGENT_DIR:-$data/pi/agent}/skills"
setup="$data/setup"
log="$setup/design-deps.log"
lock="$setup/design-deps.lock"

mkdir -p "$setup" "$cfg/venvs" "$cfg/node_modules"

say() { printf '%s %s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*" >>"$log"; }

[ -d "$skills" ] || {
  say "no skills directory at $skills; nothing to do"
  exit 0
}

# One at a time, the same way the Hindsight installer guards itself.
if ! mkdir "$lock" 2>/dev/null; then
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then
    say "removing a stale lock"
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || exit 0
  else
    say "an install is already running; leaving it alone"
    exit 0
  fi
fi
trap 'rm -rf "$lock"' EXIT

[ -x "$py" ] || py="$(command -v python3 || true)"
[ -x "$py" ] || {
  say "no python3 available; cannot build the design venvs"
  exit 1
}

failed=0
name=""
for src in "$skills"/*; do
  [ -d "$src" ] || continue
  name="$(basename "$src")"

  # --- Python: a venv per skill with a requirements.txt ------------------
  if [ -f "$src/requirements.txt" ]; then
    venv="$cfg/venvs/$name"
    if [ -x "$venv/bin/python" ]; then
      say "$name venv already present"
    else
      say "creating the $name venv"
      rm -rf "$venv"
      mkdir -p "$(dirname "$venv")"
      if PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
        "$py" -m venv "$venv" >>"$log" 2>&1 &&
        PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
          "$venv/bin/python" -m pip install -r "$src/requirements.txt" >>"$log" 2>&1; then
        say "$name venv ready"
      else
        say "$name venv install failed; see the log above"
        failed=1
        continue
      fi
    fi
    # Playwright drives a real browser. Best effort: it is a second large
    # download, and only the screenshot step needs it.
    if [ -x "$venv/bin/playwright" ]; then
      if [ -n "$(find "$data/cache/ms-playwright" -maxdepth 1 -name 'chromium*' 2>/dev/null)" ]; then
        say "$name chromium already present"
      else
        say "downloading the $name chromium browser"
        "$venv/bin/playwright" install chromium >>"$log" 2>&1 ||
          say "$name chromium download failed; screenshots will not work yet"
      fi
    fi
  fi

  # --- Node: a module store per skill with a package.json ----------------
  if [ -f "$src/package.json" ]; then
    store="$cfg/node_modules/$name"
    if [ -d "$store/node_modules" ]; then
      say "$name npm store already present"
    else
      say "installing the $name npm store"
      rm -rf "$store"
      mkdir -p "$store"
      cp "$src/package.json" "$store/package.json"
      [ -f "$src/package-lock.json" ] && cp "$src/package-lock.json" "$store/package-lock.json"
      if [ -x "$npm" ] &&
        (cd "$store" && "$npm" install >>"$log" 2>&1); then
        say "$name npm store ready"
      else
        say "$name npm install failed; see the log above"
        failed=1
        continue
      fi
    fi
  fi
done

# The skills reach their dependencies through these links, and the launcher
# only creates them for stores that already existed at launch. Setup happens
# mid-session, so this has to link what it just installed.
for store in "$cfg/node_modules"/*; do
  [ -d "$store/node_modules" ] || continue
  target="$skills/$(basename "$store")/node_modules"
  [ -d "$(dirname "$target")" ] || continue
  [ -e "$target" ] || ln -s "$store/node_modules" "$target"
done
for venv in "$cfg/venvs"/*; do
  [ -x "$venv/bin/python" ] || continue
  target="$skills/$(basename "$venv")/.venv"
  [ -d "$(dirname "$target")" ] || continue
  [ -e "$target" ] || ln -s "$venv" "$target"
done

if [ "$failed" != 0 ]; then
  say "some design dependencies failed; re-run mash-design-deps"
  exit 1
fi
say "design dependencies are ready"
exit 0
