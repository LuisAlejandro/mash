#!/bin/bash
# Install one selected tool into Mash's own data folder, without elevation.
#
#   mash-tool-install <component> [target]
#
# Mash-managed tools resolve exact pins from packaging/assets.json. The package
# strategy only reports host availability: its referenceVersion is informational
# and never used to install, upgrade or downgrade a brew/apt dependency.
# Release binaries land in versioned directories; their shims switch only after
# the download verifies, so a failed download leaves the previous tool working.
#
# Layout, all under the data folder the launcher owns:
#   local/tools/<component>/<version>/   the unpacked tool
#   local/npm/                           packages installed with the bundled npm
#   local/venv/<component>/              python tools
#   bin/<command>                        shims, first on every pane's PATH
#
# Exit 3 means "provided by the system": the tool is expected from the platform
# package manager, so setup should report it and continue rather than fail.
#
#   mash-tool-install sentrux
#   mash-tool-install cua-driver linux-arm64
set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)"
res="$(cd "$self/.." && pwd)"

# The helper runs from two places: beside the payload in a package, where the
# manifest sits one level above the resource root, and from this repository,
# where it is under packaging/helpers. Walk up rather than assume either, so a
# staged-build run and an installed run find the same manifest.
manifest=""
probe="$res"
inspected=""
while [ "$probe" != "/" ]; do
  inspected="$inspected $probe"
  if [ -f "$probe/assets/assets.py" ]; then
    manifest="$probe/assets/assets.py"
    break
  fi
  if [ -f "$probe/assets.py" ]; then
    manifest="$probe/assets.py"
    break
  fi
  if [ -f "$probe/packaging/assets.py" ]; then
    manifest="$probe/packaging/assets.py"
    break
  fi
  probe="$(dirname "$probe")"
done
[ -n "$manifest" ] || {
  printf 'mash-tool-install: cannot find assets.py in%s\n' "$inspected" >&2
  exit 1
}

data="${MASH_DATA_DIR:-${HOME:?MASH_DATA_DIR or HOME is required}/.mash}"
component="${1:-}"
# Installed payloads carry their own Python; source-tree test runs can fall back
# to the host. The wizard runs before isolation, so PATH alone is not reliable.
resolver_python="$res/bin/python3"
[ -x "$resolver_python" ] || resolver_python=python3
target="${2:-$("$resolver_python" "$manifest" target)}"
[ -n "$component" ] || {
  printf 'usage: mash-tool-install <component> [target]\n' >&2
  exit 2
}

# Stock macOS has shasum, not sha256sum. A checksum that cannot be computed
# must fail the install, never pass it, so both forms are handled explicitly.
verify_sha256() {
  local want="$1" file="$2" got=""
  if command -v sha256sum >/dev/null 2>&1; then
    got="$(sha256sum "$file" 2>/dev/null | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    got="$(shasum -a 256 "$file" 2>/dev/null | awk '{print $1}')"
  else
    return 1
  fi
  [ -n "$got" ] && [ "$got" = "$want" ]
}

setup="$data/setup"
log="$setup/tool-install.log"
mkdir -p "$setup" "$data/local/tools" "$data/bin"
say() { printf '%s %s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*" >>"$log"; }

# One install at a time; a lock older than two hours belongs to a dead run.
lock="$setup/tool-install.lock"
if ! mkdir "$lock" 2>/dev/null; then
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || exit 1
  else
    say "another install is running; waiting is the caller's job"
    exit 1
  fi
fi
trap 'rm -rf "$lock"' EXIT

spec="$("$resolver_python" "$manifest" resolve-shell "$component" "$target")" || {
  say "$component is not pinned for $target"
  exit 1
}
eval "$spec"

if [ "$STRATEGY" = package ]; then
  say "checking $component (host-managed; version not enforced)"
else
  say "installing $component $VERSION for $target (strategy $STRATEGY)"
fi
# A step that exists to honour one strategy must not silently accept another:
# the macOS npm and pinned-binary steps each refuse anything else, rather than
# reporting a host package as satisfied.
if [ "${MASH_INSTALL_NPM_ONLY:-0}" = 1 ] && [ "$STRATEGY" != npm ]; then
  say "$component requires an npm pin, got strategy $STRATEGY"
  exit 1
fi
if [ "${MASH_INSTALL_BINARY_ONLY:-0}" = 1 ] && [ "$STRATEGY" != binary ]; then
  say "$component requires a pinned binary, got strategy $STRATEGY"
  exit 1
fi

# The names a pane runs for a component. Most packages name their executable
# after the package; these do not. An empty list means the package is a library
# with no executable to link or probe.
shim_names() {
  case "$1" in
  cua-driver) printf 'cua-driver\n' ;;
  # The release asset carries a platform suffix; panes run the bare name.
  marksman) printf 'marksman\n' ;;
  latexindent) printf 'latexindent\n' ;;
  svelte-language-server) printf 'svelteserver\n' ;;
  python-lsp-server) printf 'pylsp\n' ;;
  vscode-langservers-extracted)
    printf '%s\n' \
      vscode-css-language-server \
      vscode-json-language-server \
      vscode-html-language-server
    ;;
  prettier-plugin-svelte) ;; # library only
  *) printf '%s\n' "$1" ;;
  esac
}

# Some language servers exit nonzero for --version and --help because neither
# flag is part of their protocol. Their shim existing and being executable is
# the readiness check; probing them would reject a good install.
probe_needs_flags() {
  case "$1" in
  vscode-langservers-extracted | tailwindcss-language-server) return 1 ;;
  *) return 0 ;;
  esac
}

already() {
  local marker="$1"
  [ -f "$marker" ]
}

# macOS ships Bash 3.2, which has arrays but no mapfile.
names=()
while IFS= read -r name; do
  names+=("$name")
done < <(shim_names "$component")

case "$STRATEGY" in
package)
  # The platform supplies this one. Mash does not vendor it and does not ask for
  # privileges, so the honest answer is to report it and move on. The command a
  # pane runs can differ from the component name (pylsp, svelteserver), so ask
  # the same map the other strategies use.
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if command -v "$name" >/dev/null 2>&1; then
      say "$component is provided by the system as $name"
      exit 0
    fi
  done < <(shim_names "$component")
  say "$component is expected from the system package manager; not installed by Mash"
  exit 3
  ;;

binary)
  dest="$data/local/tools/$component/$VERSION"
  name="${names[0]:-}"
  [ -n "$name" ] || {
    say "$component has no executable to shim"
    exit 1
  }
  if already "$dest/.mash-installed"; then
    say "$component $VERSION is already installed"
  else
    tmp="$(mktemp -d)"
    if ! curl -fL --retry 3 --max-time 900 -o "$tmp/archive" "$URL" >>"$log" 2>&1; then
      say "download failed for $component $VERSION"
      rm -rf "$tmp"
      exit 1
    fi
    if ! verify_sha256 "$SHA256" "$tmp/archive"; then
      say "$component $VERSION failed its checksum"
      rm -rf "$tmp"
      exit 1
    fi
    mkdir -p "$tmp/x"
    case "$ARCHIVE" in
    tar.gz) tar -xzf "$tmp/archive" -C "$tmp/x" >>"$log" 2>&1 ;;
    tar.xz) tar -xJf "$tmp/archive" -C "$tmp/x" >>"$log" 2>&1 ;;
    zip) unzip -q "$tmp/archive" -d "$tmp/x" >>"$log" 2>&1 ;;
    gz)
      gunzip -c "$tmp/archive" >"$tmp/x/$(basename "$MEMBER")"
      ;;
    raw) cp "$tmp/archive" "$tmp/x/$(basename "$MEMBER")" ;;
    *)
      say "$component uses unsupported archive $ARCHIVE"
      rm -rf "$tmp"
      exit 1
      ;;
    esac
    rm -rf "$dest.new"
    mkdir -p "$dest.new"
    # Runtimes ship a tree; release binaries may have an architecture suffix.
    # A tar.gz can also place its member in a subdirectory, so search when the
    # archive did not land it at the path the manifest names.
    if [ -d "$tmp/x/$MEMBER" ]; then
      cp -R "$tmp/x/$MEMBER/." "$dest.new/"
    elif [ -f "$tmp/x/$MEMBER" ]; then
      cp "$tmp/x/$MEMBER" "$dest.new/$name"
    else
      found="$(find "$tmp/x" -type f -name "$(basename "$MEMBER")" -print -quit)"
      [ -n "$found" ] || {
        say "$component archive has no $MEMBER"
        rm -rf "$tmp"
        exit 1
      }
      cp "$found" "$dest.new/$name"
    fi
    chmod -R u+w "$dest.new"
    printf '%s\n' "$VERSION" >"$dest.new/.mash-installed"
    rm -rf "$dest"
    mv "$dest.new" "$dest"
    rm -rf "$tmp"
    say "$component $VERSION unpacked"
  fi
  # Sentrux hardcodes ~/.sentrux/plugins and loads grammar .so files. Keep both
  # its writable state and the checksum-pinned grammars inside Mash's data dir.
  if [ "$component" = sentrux ]; then
    [ -n "${GRAMMARS_URL:-}" ] && [ -n "${GRAMMARS_SHA256:-}" ] || {
      say "sentrux has no pinned grammars for $target"
      exit 1
    }
    grammars="$data/.sentrux/.grammars-$VERSION-$target"
    if [ "$(cat "$grammars" 2>/dev/null)" != "$GRAMMARS_SHA256" ]; then
      tmp="$(mktemp -d)"
      if ! curl -fL --retry 3 --max-time 900 -o "$tmp/grammars.tar.gz" "$GRAMMARS_URL" >>"$log" 2>&1 ||
        ! verify_sha256 "$GRAMMARS_SHA256" "$tmp/grammars.tar.gz"; then
        say "sentrux $VERSION grammars download or checksum failed"
        rm -rf "$tmp"
        exit 1
      fi
      mkdir -p "$data/.sentrux/plugins"
      if ! tar -xzf "$tmp/grammars.tar.gz" -C "$data/.sentrux/plugins" >>"$log" 2>&1; then
        say "sentrux $VERSION grammars could not be unpacked"
        rm -rf "$tmp"
        exit 1
      fi
      printf '%s\n' "$GRAMMARS_SHA256" >"$grammars"
      rm -rf "$tmp"
    fi
  fi
  # Point the shim at this version only after both downloads verified.
  target_bin="$(find "$dest" -maxdepth 2 -type f -name "$name" -print -quit)"
  [ -n "$target_bin" ] || {
    say "$component $VERSION has no $name executable"
    exit 1
  }
  chmod 755 "$target_bin"
  if [ "$component" = sentrux ]; then
    # Only Sentrux's process gets a different HOME; Mash's panes keep the real one.
    {
      printf '#!/bin/sh\n'
      printf 'd="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"\n'
      printf 'HOME="$d" exec "$d/local/tools/sentrux/%s/sentrux" "$@"\n' "$VERSION"
    } >"$data/bin/sentrux.new"
    chmod 755 "$data/bin/sentrux.new"
    mv -f "$data/bin/sentrux.new" "$data/bin/sentrux"
  else
    ln -sfn "$target_bin" "$data/bin/$name"
  fi
  say "$component $VERSION installed as bin/$name"
  ;;

npm)
  prefix="$data/local/npm"
  marker="$prefix/.mash-version-$component"
  if [ -f "$marker" ] && [ "$(cat "$marker")" = "$VERSION" ]; then
    say "$component $VERSION is already installed"
  else
    mkdir -p "$prefix"
    if ! env HOME="$data" PATH="$res/node/bin:$PATH" npm_config_cache="$data/cache/npm" \
      "$res/node/bin/npm" install --global --prefix "$prefix" \
      "${PACKAGE:-$component}@$VERSION" >>"$log" 2>&1; then
      say "npm install failed for $component $VERSION"
      exit 1
    fi
    printf '%s\n' "$VERSION" >"$marker"
    say "$component $VERSION installed"
  fi
  # Linux's /opt/letsmash path is fixed, so its scripts name the bundled node
  # directly. A macOS app can move: keep npm's `#!/usr/bin/env node` there;
  # Mash puts the current bundle's node first on PATH in every pane and probe.
  if [ "$(uname -s)" = Linux ]; then
    node_real="$res/node/bin/node"
    # npm links most bins to an entry file; rewrite that target, not the link.
    while IFS= read -r bin_script; do
      resolved="$(readlink -f "$bin_script" 2>/dev/null || printf '%s' "$bin_script")"
      [ -f "$resolved" ] || continue
      # `read` drops NUL bytes instead of warning on binary entry points.
      first_line=""
      IFS= read -r first_line <"$resolved" 2>/dev/null || true
      case "$first_line" in
      '#!/usr/bin/env node')
        {
          echo "#!$node_real"
          tail -n +2 "$resolved"
        } >"$resolved.mashshebang"
        mv "$resolved.mashshebang" "$resolved"
        chmod 755 "$resolved"
        ;;
      esac
    done < <(find "$prefix/bin" \( -type f -o -type l \) 2>/dev/null)
  fi
  # A symlink into the installed package stays valid; only the shim outside
  # the prefix has to be refreshed. A package can expose several binaries
  # (vscode-langservers-extracted) or none (a plugin).
  if [ "${#names[@]}" -gt 0 ]; then
    for name in "${names[@]}"; do
      target_bin="$prefix/bin/$name"
      [ -x "$target_bin" ] || {
        say "$component did not provide bin/$name"
        exit 1
      }
      ln -sfn "$target_bin" "$data/bin/$name"
    done
  fi
  ;;

pip)
  venv="$data/local/venv/$component"
  marker="$venv/.mash-version"
  if [ -f "$marker" ] && [ "$(cat "$marker")" = "$VERSION" ]; then
    say "$component $VERSION is already installed"
  else
    rm -rf "$venv.new"
    if ! env PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
      "$res/python/bin/python3" -m venv "$venv.new" >>"$log" 2>&1; then
      say "could not create the $component environment"
      exit 1
    fi
    if ! env PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
      "$venv.new/bin/python" -m pip install --upgrade "${PACKAGE:-$component}==$VERSION" \
      >>"$log" 2>&1; then
      say "pip install failed for $component $VERSION"
      rm -rf "$venv.new"
      exit 1
    fi
    printf '%s\n' "$VERSION" >"$venv.new/.mash-version"
    rm -rf "$venv"
    mv "$venv.new" "$venv"
    say "$component $VERSION installed"
  fi
  # pip writes the interpreter it was installed with into every console-script
  # shebang. It was $venv.new, which no longer exists after the rename, so each
  # script would fail with ENOENT. Point them at the final venv.
  while IFS= read -r script; do
    case "$(head -n 1 "$script" 2>/dev/null)" in
    "#!$venv.new/bin/python"*)
      {
        echo "#!$venv/bin/python"
        tail -n +2 "$script"
      } >"$script.mashshebang"
      chmod 755 "$script.mashshebang"
      mv "$script.mashshebang" "$script"
      ;;
    esac
  done < <(find "$venv/bin" -maxdepth 1 -type f 2>/dev/null)
  for name in "${names[@]}"; do
    target_bin="$venv/bin/$name"
    [ -x "$target_bin" ] || {
      say "$component did not provide bin/$name"
      exit 1
    }
    ln -sfn "$target_bin" "$data/bin/$name"
  done
  ;;

*)
  say "$component uses strategy $STRATEGY, which this helper does not install"
  exit 1
  ;;
esac

# A tool that landed but does not run is worse than one that failed loudly: the
# wizard would record setup complete and the pane would break later.
if [ "${#names[@]}" -eq 0 ]; then
  say "$component is ready (library only)"
  exit 0
fi
[ "$component" = sentrux ] && export SENTRUX_SKIP_GRAMMAR_DOWNLOAD=1
for name in "${names[@]}"; do
  shim="$data/bin/$name"
  [ -x "$shim" ] || {
    say "$component has no executable shim bin/$name"
    exit 1
  }
  if probe_needs_flags "$component"; then
    if ! PATH="$res/node/bin:$res/python/bin:$PATH" "$shim" --version >/dev/null 2>&1 &&
      ! PATH="$res/node/bin:$res/python/bin:$PATH" "$shim" --help >/dev/null 2>&1; then
      say "$component installed but bin/$name does not answer --version or --help"
      exit 1
    fi
  fi
done
say "$component is ready"
exit 0
