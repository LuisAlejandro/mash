#!/bin/bash
# Apply Mash-owned menu patches to a Ghostty fork checkout.
#
# Some menu items live in the fork but ship from this repository until the fork
# branch catches up. CI and `make test` call this when MASH_GHOSTTY_SRC is set;
# mash_ghostty_trim_check runs it before menu-chords and the trim assertions.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
src="${1:?usage: mash-ghostty-patch-menu <ghostty-src>}"
[ -d "$src" ] || {
  echo "ghostty checkout missing: $src" >&2
  exit 1
}
for name in ghostty-check-for-updates-menu.patch ghostty-update-lifecycle.patch; do
  patch="$root/packaging/patches/$name"
  [ -f "$patch" ] || continue
  # Idempotent only when the exact patch can be reversed. A changed or partly
  # applied source must fail, not be silently treated as already patched.
  if patch --dry-run -f -R -p1 -d "$src" <"$patch" >/dev/null 2>&1; then
    continue
  fi
  patch --dry-run -f -p1 -d "$src" <"$patch" >/dev/null 2>&1 &&
    patch -f -p1 -d "$src" <"$patch" || {
    echo "$name did not apply cleanly to $src" >&2
    exit 1
  }
done
