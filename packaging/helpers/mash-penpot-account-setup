#!/bin/bash
# Create the wizard's local Penpot account when Docker becomes available.
# Safe to retry: mds setup checks for an existing profile and access token.
set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)"
data="${1:-${MASH_DATA_DIR:-$HOME/.mash}}"
case "$data" in "$HOME/.mash") ;; *)
  echo "Penpot setup refused a path outside ~/.mash" >&2
  exit 1
  ;;
esac
stack="$data/local/share/mash/design"
env_file="$stack/penpot.env"
setup="$data/setup"
log="$setup/penpot-account-setup.log"
lock="$setup/penpot-account-setup.lock"
mkdir -p "$setup"
umask 077
say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$log"; }

[ -f "$env_file" ] || exit 0
[ ! -L "$env_file" ] || {
  say "refusing a symlink for Penpot config"
  exit 1
}
# Never print credentials. A complete setup is identified by its MCP token.
grep -q '^PENPOT_LOCAL_EMAIL=.' "$env_file" || exit 0
grep -q '^PENPOT_LOCAL_PASSWORD=.' "$env_file" || exit 0
grep -q '^PENPOT_ACCESS_TOKEN=.' "$env_file" && exit 0

PATH="$self:$self/../node/bin:$self/../python/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH MASH_DATA_DIR="$data" MASH_CONFIG_DIR="$data/config/mash" \
  PI_CODING_AGENT_DIR="$data/pi/agent" MASH_DESIGN_STACK="$stack" MASH_DESIGN_NONINTERACTIVE=1
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  say "Docker unavailable; local Penpot account pending. Reopen Mash after Docker starts."
  exit 0
fi
if ! mkdir "$lock" 2>/dev/null; then
  [ -f "$lock/pid" ] || exit 0
  previous="$(<"$lock/pid")"
  if [[ "$previous" =~ ^[0-9]+$ ]] && kill -0 "$previous" 2>/dev/null; then
    say "local Penpot setup already running"
    exit 0
  fi
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock/pid"
trap 'rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true' EXIT

[ -x "$stack/bin/mds" ] || {
  say "mds is missing"
  exit 1
}
say "setting up local Penpot account"
# The toolkit's raw output is private and is never shown in the wizard: a
# failed Penpot command can echo arguments from its own create-profile call.
raw="$setup/penpot-mds.log"
: >"$raw"
chmod 600 "$raw"
if ! "$stack/bin/mds" setup --skip-auth >"$raw" 2>&1; then
  say "mds setup failed; see private penpot-mds.log"
  exit 1
fi
if ! grep -q '^PENPOT_ACCESS_TOKEN=.' "$env_file"; then
  say "mds setup returned without an access token; see private penpot-mds.log"
  exit 1
fi
say "local Penpot account and MCP token ready"
exit 0
