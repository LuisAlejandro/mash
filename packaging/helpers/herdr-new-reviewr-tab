#!/usr/bin/env bash
# Open a Herdr tab with reviewr (left) and pi (right).
# Bound to cmd+r in Mash's Herdr config (config/herdr/config.toml).
set -euo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$HOME}"
ratio="${REVIEWR_RATIO:-0.6}"
here="$(dirname "$0")"

# `type = "shell"` custom commands run detached: no pane, no toast, stderr
# discarded. Every failure below would be invisible at the keybinding, so each
# one also raises a notification. Best-effort -- a failing notification must
# not mask the real error.
refuse() {
	printf 'review tab: %s\n' "$1" >&2
	"$herdr" notification show "Review tab" --body "$1" --sound none >/dev/null 2>&1 || true
	exit 1
}

pi_cmd="$("$here/mash-bin" --bundled pi)" ||
	refuse "bundled pi is missing"
if ! git -C "$cwd" rev-parse --show-toplevel >/dev/null 2>&1; then
	refuse "not a git repo: $cwd"
fi

open_args=(
	plugin pane open
	--plugin persiyanov.reviewr
	--entrypoint pane
	--placement tab
	--cwd "$cwd"
	--focus
)
if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
	open_args+=(--workspace "$HERDR_ACTIVE_WORKSPACE_ID")
fi

open_json="$("$herdr" "${open_args[@]}")"
left="$(printf '%s' "$open_json" | "$here/herdr-json" pane_id)"
tab="$(printf '%s' "$open_json" | "$here/herdr-json" tab_id)"
if [[ -z "$left" || -z "$tab" ]]; then
	refuse "failed to create tab"
fi

right="$("$herdr" pane split "$left" --direction right --ratio "$ratio" --cwd "$cwd" --no-focus | "$here/herdr-json" pane_id)"
if [[ -z "$right" ]]; then
	refuse "failed to create pi pane"
fi

# Start pi as a tracked agent; herdr-agent-start owns the tracked-vs-untracked
# rationale and the absolute-path fallback. Its stdout is the agent name, for
# callers that then focus it -- reviewr, not pi, must keep the caret here, and
# the tab focus below owns that, so discard it.
"$here/herdr-agent-start" "$right" pi pi "$pi_cmd" >/dev/null
"$herdr" tab focus "$tab"
