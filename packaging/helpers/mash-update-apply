#!/bin/bash
# Detached install coordinator. Preparation is complete before shutdown; the
# target must acknowledge its real window/server before recovery is removed.
set -u
staged="" dest="" data="" work="" version="" attempt=""
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || exit 2
  case "$1" in
  --app) staged="$2" ;; --dest) dest="$2" ;; --data) data="$2" ;;
  --work) work="$2" ;; --version) version="$2" ;; --attempt) attempt="$2" ;;
  *) exit 2 ;;
  esac
  shift 2
done
case "$dest" in /*.app) ;; *) exit 2 ;; esac
case "$(basename "$work")" in mash-update-??????) ;; *) exit 2 ;; esac
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 2
[ -n "$attempt" ] && [ -d "$dest/Contents" ] && [ ! -L "$dest" ] && [ -d "$work" ] && [ ! -L "$work" ] || exit 2
self="$(cd "$(dirname "$0")" && pwd)" || exit 2
# shellcheck source=mash-update-common
source "$self/mash-update-common" || exit 1
mash_update_init "$data" || exit 1
MU_ID="$attempt"
[ "$(mash_update_read id)" = "$MU_ID" ] && [ "$(mash_update_read work)" = "$work" ] &&
  [ "$(mash_update_read app)" = "$dest" ] && [ "$(mash_update_read candidate)" = "$version" ] || exit 2
phase="$(mash_update_read phase)"
case "$phase" in ready | handoff) ;; *) exit 2 ;; esac
parent="$(cd "$(dirname "$dest")" && pwd -L)" || exit 2
sibling="$(mash_update_read sibling)" || exit 2
case "$sibling" in "$parent"/.mash-update-??????) ;; *) exit 2 ;; esac
[ "$dest" = "$parent/$(basename "$dest")" ] && [ "$staged" = "$sibling/Mash.app" ] &&
  [ ! -L "$sibling" ] && [ -d "$staged/Contents" ] && [ -w "$parent" ] || exit 2
for helper in mash-update-processes mash-update-swap; do [ -x "$work/$helper" ] || exit 2; done
mash_update_bundle_is "$staged" "$version" "$(mash_update_read expected_uuid)" || exit 2
mash_update_claim || exit 1
job="$(mash_update_read job)"
swapped=0 stopped=0
cleanup() {
  mash_update_hide_progress
  case "$(mash_update_read phase || true)" in
  confirmed | failed-before-swap | cancelled)
    if [ "$swapped" = 0 ] || [ "$(mash_update_read phase)" = confirmed ]; then rm -rf "$sibling" "$work"; fi
    ;;
  esac
  if [ "${XPC_SERVICE_NAME:-}" = "$job" ]; then
    (sleep 1; launchctl bootout "gui/$(id -u)/$job") </dev/null >/dev/null 2>&1 &
  fi
}
trap cleanup EXIT
failure() {
  local reason="$1" title
  case "$(mash_update_read phase)" in confirmed | restored-previous) exit 0 ;; esac
  mash_update_log "failure=$reason swapped=$swapped"
  mash_update_write last_error "$reason" || true
  if [ "$swapped" = 0 ]; then
    mash_update_finish failed-before-swap || true
    printf '%s\n' "$version" >"$MU_STATE/update-retry"
    if [ "$(cat "$MU_STATE/update-notice" 2>/dev/null)" = "$version" ]; then rm -f "$MU_STATE/update-notice"; fi
    title='Mash update did not install'
    [ "$stopped" = 0 ] || mash_update_run 15 reopen-previous open "$dest" || true
  else
    mash_update_finish recovery-required || true
    title='Mash installed; startup needs recovery'
    mash_update_hide_progress
    # Recovery runs as its own launchd-owned coordinator, not in the failed
    # target's GUI. A hung new process cannot swallow the recovery controls.
    "$self/mash-update-gate" recover "$dest" "$data" "$MU_ID" || true
  fi
  mash_update_run 5 notification osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
    "$title" "$reason" || true
  exit 1
}
if [ "$phase" = handoff ]; then
  deadline="$(mash_update_read handoff_deadline)" || exit 1
  while [ "$(mash_update_read handoff_released 2>/dev/null)" != 1 ]; do
    [ "$(mash_update_read phase)" = handoff ] || exit 1
    verifier="$(mash_update_read verifier_pid)"
    [ "$(mash_update_stamp "$verifier")" = "$(mash_update_read verifier_start)" ] || break
    [ "$("$self/mash-update-processes" now)" -lt "$deadline" ] || failure 'The verifier did not release the acknowledged worker.'
    sleep 0.1
  done
fi
mash_update_phase quiescing || exit 1
printf '%s\n' "$version" >"$MU_STATE/update-pending"
mash_update_progress || true
old="$work/old-processes"
stopped=1
mash_update_quiesce "$dest" "$old" || failure 'Mash did not completely quit; the previous installation was not replaced.'
mash_update_write shutdown_snapshot "$old" || failure 'Could not record shutdown.'
# No large copy or assessment follows this final admission/ownership check.
mash_update_phase swap-intent || failure 'Could not record the exchange intent.'
"$self/mash-update-processes" list "$dest" "$data" >"$work/final-processes" || failure 'Could not perform the final shutdown check.'
[ ! -s "$work/final-processes" ] || failure 'Mash reopened before replacement; the previous installation was not replaced.'
"$work/mash-update-swap" "$staged" "$dest" >>"$MU_STATE/mash-update.log" 2>&1 ||
  failure 'This disk cannot atomically update Mash; the previous installation was not replaced.'
swapped=1
mash_update_launch_state "$old" || failure 'The target was installed but readiness state could not be recorded.'
rm -f "$MU_STATE/update-pending" "$MU_STATE/update-retry"
mash_update_run 15 launch open "$dest" || failure 'The target is installed but could not be launched. Its recovery copy was retained.'
while :; do
  if mash_update_confirm; then mash_update_log "ready_version=$version"; exit 0; fi
  [ "$(mash_update_read phase)" != confirmed ] || exit 0
  remaining="$(mash_update_remaining)" || failure 'Could not read the target readiness deadline.'
  [ "$remaining" -gt 0 ] || failure 'The target did not confirm a usable window and server. Recovery controls are available; both app copies were retained.'
  sleep 0.2
done
