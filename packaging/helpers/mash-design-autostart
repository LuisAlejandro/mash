#!/bin/bash
# Start the Mash Design Skills stack (Penpot + OpenDesign) when Mash opens.
#
# Opt-in only. The startup wizard writes ~/.mash/config/mash/design-autostart;
# without that file this exits immediately. Do not add startup from anywhere
# else: `mds start` is heavy (Compose up, an OpenDesign build on the first run,
# then harness logins and studio seeding), so it must stay something the owner
# asked for.
#
# Runs in the background from the launcher and never delays the window, the same
# way mash-penpot-account-setup does. A launch with Docker stopped only logs; the
# next launch retries, because the marker is still there.
set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)"
data="${1:-${MASH_DATA_DIR:-$HOME/.mash}}"
case "$data" in "$HOME/.mash") ;; *)
  echo "Design autostart refused a path outside ~/.mash" >&2
  exit 1
  ;;
esac
stack="$data/local/share/mash/design"
marker="$data/config/mash/design-autostart"
setup="$data/setup"
log="$setup/design-autostart.log"
lock="$setup/design-autostart.lock"
account_lock="$setup/penpot-account-setup.lock"
[ -f "$marker" ] || exit 0
mkdir -p "$setup"
umask 077
say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$log"; }
[ ! -L "$marker" ] || { say "refusing a symlink for design autostart"; exit 1; }

PATH="$self:$self/../node/bin:$self/../python/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH MASH_DATA_DIR="$data" MASH_CONFIG_DIR="$data/config/mash" \
  PI_CODING_AGENT_DIR="$data/pi/agent" MASH_DESIGN_STACK="$stack" \
  MASH_DESIGN_NONINTERACTIVE=1

[ -x "$stack/bin/mds" ] || {
  say "mds is missing; the design stack cannot start"
  exit 1
}

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  say "Docker unavailable; design stack not started. Reopen Mash after Docker starts."
  exit 0
fi

if ! mkdir "$lock" 2>/dev/null; then
  [ -f "$lock/pid" ] || exit 0
  previous="$(<"$lock/pid")"
  if [[ "$previous" =~ ^[0-9]+$ ]] && kill -0 "$previous" 2>/dev/null; then
    say "design stack autostart already running"
    exit 0
  fi
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock/pid"
trap 'rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true' EXIT

# An account setup from an earlier launch may still be running. The pane entry
# now selects only one helper per launch; don't overlap an older one either.
if [ -f "$account_lock/pid" ]; then
  previous="$(<"$account_lock/pid")"
  if [[ "$previous" =~ ^[0-9]+$ ]] && kill -0 "$previous" 2>/dev/null; then
    say "Penpot account setup still running; retry design stack next launch"
    exit 0
  fi
fi
[ -f "$marker" ] || exit 0
# ponytail: each new Mash window repeats mds start. Compose reconciles running
# services; if repeated build checks become costly, gate on service health.
say "starting the design stack"
# The CLI's own output is not written here: it can echo env values on failure.
# Only the outcome is recorded, and the private log holds the details.
raw="$setup/design-autostart-mds.log"
: >"$raw"
chmod 600 "$raw"
if ! "$stack/bin/mds" start >"$raw" 2>&1; then
  say "mds start failed; see private design-autostart-mds.log"
  exit 1
fi
say "design stack started"
exit 0
