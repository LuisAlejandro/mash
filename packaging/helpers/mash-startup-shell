#!/bin/bash
# A quiet interactive shell for panes waiting for an automatic launch.
#
# Herdr sends agent/restore commands to an interactive shell. Clearing inside
# pi or herdr-fresh-pane is too late: the prompt and command have already been
# rendered. This is that shell, but with no prompt, terminal echo, readline,
# history or user rc. It is still the pane's original shell process, so Herdr
# can start/name/wait for agents normally; Pi itself remains foreground.
#
# Ordinary shell tabs never use this. A normal program exit opens the user's
# normal Mash shell. Parking writes a recovery record before terminating the
# program, so a parked pane stays quiet for its next wake command.

if [[ ${MASH_STARTUP_SHELL_RC:-} != 1 || $- != *i* ]]; then
    export MASH_STARTUP_SHELL_RC=1 BASH_SILENCE_DEPRECATION_WARNING=1
    exec /bin/bash --noprofile --rcfile "$0" --noediting -i
fi

HISTFILE=/dev/null
HISTSIZE=0
PS1=''
PS2=''
PS4=''
unset ENV BASH_ENV
set +o history
_mash_startup_tty="$(stty -g 2>/dev/null)"
_mash_startup_self="${BASH_SOURCE[0]}"
_mash_startup_self_dir="${_mash_startup_self%/*}"
_mash_startup_seen=0
_mash_startup_record="${MASH_DATA_DIR:-$HOME/.mash}/local/state/dev-tab-park/${HERDR_PANE_ID/:/_}"

# The modes a full-screen program turns on and the terminal keeps until something
# turns them off. A program that dies -- parked, crashed, killed -- leaves them
# set, so the shell that gets the pane back receives mouse reports as literal
# bytes: every pointer move is typed into the prompt and "executed", filling the
# screen with `35;12;7M` and the history with nonsense. Nothing else resets them,
# because the program that would have done so is gone.
_mash_reset_terminal_modes() {
    [ -t 1 ] || return 0
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1004l\033[?1006l\033[?2004l\033[?25h'
}

_mash_normal_shell() {
    trap - INT
    [[ -z $_mash_startup_tty ]] || stty "$_mash_startup_tty" 2>/dev/null
    _mash_reset_terminal_modes
    unset MASH_STARTUP_SHELL_RC MASH_PANE_STARTUP MASH_DEV_TAB_FRESH
    export MASH_STARTUP_GATE_DONE=1
    exec mash-shell
}
trap '_mash_normal_shell' INT

_mash_startup_prompt() {
    local record="$_mash_startup_record"
    # After an explicit quit, return a real prompt. A parked process instead
    # leaves a record and must not expose/echo the command that wakes it.
    if [[ $_mash_startup_seen == 1 && ! -f $record ]]; then
        _mash_normal_shell
    fi
    _mash_startup_seen=1
    stty -echo 2>/dev/null
    # Preserve shell-integration readiness without a visible prompt. Herdr's
    # agent.start validates this shell and still waits for the real agent.
    printf '\033]133;A\007\033]133;B\007'
}
PROMPT_COMMAND=_mash_startup_prompt
# A launch that fails returns to this prompt, and the next cycle hands the pane
# back as an ordinary shell (see _mash_startup_prompt). While a park record
# exists the pane stays quiet instead: its wake arrives on focus.
#
# A launch that never arrives produces no second prompt at all, so that rule
# cannot fire and the pane would sit here for ever -- echo off, no input read,
# showing only "Starting the editor". That is not a rare shape: a pane whose
# auto-launch failed, or a tab whose split never happened, shows exactly this.
# Give it a grace period and then hand the pane back as an ordinary shell. A
# parked pane is exempt: its record means a wake is expected on focus.
#
# The window is generous on purpose. Herdr staggers restored launches by
# `session.startup_per_agent_delay_ms` (100 ms by default), so a session with a
# few hundred panes legitimately types the last command a minute after start.
# Handing a pane back early is not an error -- the command still runs, in the
# normal shell instead of this quiet one -- but it is a visible flash the wait
# exists to avoid.
if [[ ! -f $_mash_startup_record ]]; then
    (
        sleep "${MASH_STARTUP_GRACE:-60}"
        # The pane's program replaces this shell on a successful launch, so only
        # a shell still running this rc reaches the signal. Compare the command
        # line rather than trusting a bare PID, which the system may have reused.
        ps -p "$$" -o args= 2>/dev/null | grep -q mash-startup-shell || exit 0
        kill -INT "$$" 2>/dev/null
    ) >/dev/null 2>&1 &
fi
stty -echo 2>/dev/null
mash-pane-starting "${MASH_PANE_STARTUP:-agent}" "${HERDR_PANE_ID:-}" 2>/dev/null || true
