#!/bin/sh
# Run Fresh in this pane with right-click routed to Fresh rather than Herdr.
#
# Why this exists: Herdr's per-pane routing is set with
# `herdr pane input --right-click pane`, but there is no hook for "this pane
# started running Fresh" -- Fresh is not a recognized agent, so pane.agent_detected
# never fires for it. Where we create the pane ourselves (bin/herdr-new-dev-tab,
# bin/telescope-files) we already know the pane id and just call `pane input`
# directly. sesh creates its own panes from a GitHub-managed plugin we cannot
# edit, so its `[[tab.pane]]` startup points here instead and this finds its own
# pane.
#
# `pane current` resolves the caller's pane from HERDR_PANE_ID, which is how
# bin/telescope-files already resolves its invoking pane. Best-effort: if it
# cannot be resolved we still launch Fresh, just with Herdr's right-click menu.
#
# `exec` matters. It replaces this process with Fresh, so the pane's foreground
# process is `fresh` -- which is what the Fresh-pane detection in
# bin/herdr-new-dev-tab and bin/telescope-files keys on. Without exec the
# foreground would be this script and those checks would miss the pane.
#
# `--daemon` attaches to the shared daemon for this directory instead of
# starting a private editor. Only dev tabs pass it: Mash wants one editor per
# directory there, so every dev tab in a workspace looks at the same buffers
# instead of paying for its own copy and its own language servers. Panes that
# are not dev tabs (telescope, sesh) stay private -- they are short-lived, their
# layout differs, and a shared editor would make them betray the dev tab they
# happen to sit in.
#
# Extra arguments are dropped in daemon mode. They cannot reach the daemon --
# the spawner forwards only the session name, the ssh url and the locale -- so
# passing them would only invite the belief that they did something.
set -eu

daemon=0
case "${1:-}" in
--daemon)
	daemon=1
	shift
	;;
esac

herdr="${HERDR_BIN_PATH:-herdr}"

if pane="$("$herdr" pane current 2>/dev/null |
	sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p' | head -n 1)" && [ -n "$pane" ]; then
	"$herdr" pane input --pane "$pane" --right-click pane >/dev/null 2>&1 || true

	# Report the command that reopens this pane, so a Herdr server restart brings
	# Fresh back instead of leaving a shell. Herdr only resumes panes it knows how
	# to reopen, and Fresh is not an agent, so without this the pane is restored
	# from session.json, which records only cwd and label for non-agent panes.
	#
	# The `-- <command>` form is why this must go through Herdr 0.9.3, the
	# version Mash pins. A report failure is swallowed here: the pane still runs
	# Fresh either way, it just comes back as a shell after a restart.
	#
	# The command must start with a plain PATH command name (not a path), which is
	# why this script is symlinked into ~/.local/bin. `.` is the pane's directory:
	# Herdr reopens the pane in the same directory and runs the command there, and
	# Fresh restores its own buffers and cursor from its state for that directory.
	# The report is repeated by every launch, including a resumed one, so the
	# pane keeps its resume command as long as it keeps being Fresh.
	#
	# The source names this pane. Herdr 0.9.3 resumes at most one pane per
	# reporter source, so with one shared name a restart reopened only the first
	# dev tab's Fresh and left every other one a bare shell, then dropped their
	# resume command from the next save. test_fresh_pane_resume.sh covers it.
	resume='herdr-fresh-pane .'
	if [ "$daemon" = 1 ]; then
		resume='herdr-fresh-pane --daemon .'
		# Mark the pane as shared for the split-ratio sync. Only panes that
		# attach to a daemon need the workspace's dev tabs kept at one size:
		# the daemon draws a single grid for all of them, so the first client's
		# size would break a smaller pane and letterbox a larger one. A private
		# editor is unaffected and is deliberately left untagged.
		"$herdr" pane report-metadata "$pane" --source "fresh-daemon" \
			--token mash-fresh-daemon=1 >/dev/null 2>&1 || true
	fi
	"$herdr" pane report-agent "$pane" --source "fresh-pane:$pane" --agent fresh \
		--state idle --seq "$(date +%s)" -- $resume >/dev/null 2>&1 || true
fi

# Say the editor is coming instead of leaving the prompt and the command that
# asked for it on screen: the Herdr pane label spans the whole start, and the
# runner animates in the pane until Fresh paints its first frame.
mash-pane-starting editor "$pane" >/dev/null 2>&1 || true

runner=""
for dir in $(printf '%s\n' "${MASH_BIN:-}" | tr ':' ' '); do
	[ -x "$dir/mash-pane-runner" ] || continue
	runner="$dir/mash-pane-runner"
	break
done

if [ "$daemon" = 1 ]; then
	if [ -n "$runner" ]; then
		exec "$runner" --label "$(mash-pane-starting --print editor 2>/dev/null || printf 'Starting the editor...')" -- fresh -a
	fi
	exec fresh -a
fi
if [ -n "$runner" ]; then
	exec "$runner" --label "$(mash-pane-starting --print editor 2>/dev/null || printf 'Starting the editor...')" -- fresh "$@"
fi
# Fresh 0.5.2+ sends a bare `fresh` to one shared background daemon unless
# `auto_attach` is off, which Mash's seeded config sets. That default does not
# apply here: dev tabs ask for the shared editor explicitly with `--daemon`
# above, and a plain `fresh <path>` pane keeps its own editor.
exec fresh "$@"
