#!/bin/bash
# Tell the user, once per version, that a newer Mash is available.
#
#   mash-update-notice <resource-root> <data-dir>
#
# Started in the background by herdr-pane for every window. Where the next
# version comes from is the only thing that differs by platform:
#
#   Linux  the APT cache Ubuntu already refreshes on its own. Nothing here
#          touches the network or writes package state, so a user who removed
#          the letsmash source simply has no candidate and never sees a notice.
#          Installing is apt's job; the notice is read-only.
#   macOS  the GitHub releases API, at most once every 24 hours. There is no
#          package manager to delegate to, so the notice is interactive and
#          Mash installs the release itself.
#
# Once per version, across every window: the version is recorded under a lock
# before any surface fires, so two windows opening together cannot both
# announce it, and a version is never announced twice even when a surface
# fails. Every failure is silent -- this must never get in the way of a launch.
set -u

res="${1:-}"
d="${2:-}"
[ -n "$res" ] && [ -n "$d" ] && [ -d "$d" ] || exit 0

system="$(uname -s 2>/dev/null)"
state="$d/local/state"
record="$state/update-notice"
checked="$state/update-checked"
lock="$state/update-notice.lock"
mkdir -p "$state" 2>/dev/null || exit 0

# The portable mkdir lock, as in mash-seed-sync: flock is not on macOS, and
# these scripts are shared. A lock whose owner died must not strand the notice.
mash_take_lock() {
  local tries=0 owner
  while ! mkdir "$lock" 2>/dev/null; do
    owner="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$lock"
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -ge 50 ] && return 1
    sleep 0.1
  done
  echo "$$" >"$lock/pid"
}

mash_write() { # mash_write FILE VALUE -- replace a one-line state file
  printf '%s\n' "$2" >"$1.tmp" && mv "$1.tmp" "$1"
}

# --- Linux: the local APT cache ------------------------------------------------
# Sets installed/candidate, or returns 1 when no notice is due. Reads only.
mash_linux_candidate() {
  # The Candidate: label is localized, and the installed version must be
  # exactly what dpkg reports, so parse in the C locale.
  export LC_ALL=C
  installed="$(dpkg-query -W -f='${Version}' letsmash 2>/dev/null)" || return 1
  candidate="$(apt-cache policy letsmash 2>/dev/null | sed -n 's/^ *Candidate: *//p' | head -n 1)"
  [ -n "$installed" ] && [ -n "$candidate" ] && [ "$candidate" != "(none)" ] || return 1
  dpkg --compare-versions "$candidate" gt "$installed" 2>/dev/null
}

# --- macOS: the GitHub releases API --------------------------------------------
# dpkg is not on macOS, so ordering is decided on the dotted integers Mash
# actually uses. Anything that does not parse that way is "not newer", so a
# surprising tag can never trigger an update.
mash_version_gt() {
  python3 - "$1" "$2" <<'PY' 2>/dev/null
import re
import sys


def parse(value):
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", value):
        raise ValueError("not a Mash release")
    return tuple(int(part) for part in value.split("."))


try:
    sys.exit(0 if parse(sys.argv[1]) > parse(sys.argv[2]) else 1)
except (ValueError, IndexError):
    sys.exit(1)
PY
}

# A one-line state file, or the empty string. `read` from a missing path is a
# shell error on stderr rather than a failed command, and this helper must stay
# completely silent, so the existence check comes first.
mash_read_line() {
  local value=""
  [ -f "$1" ] && read -r value <"$1"
  printf '%s' "$value"
}

mash_macos_candidate() {
  installed="$(mash_read_line "$res/VERSION")"
  [ -n "$installed" ] || return 1
  # One request a day, whatever the user does with windows. The lock is already
  # held, so two launches cannot both decide the window has expired.
  local now last
  now="$(date +%s)"
  last="$(mash_read_line "$checked")"
  case "$last" in
  '' | *[!0-9]*) last=0 ;;
  esac
  [ "$((now - last))" -ge 86400 ] || return 1
  mash_write "$checked" "$now"
  local body
  body="$(curl -fsSL --max-time 10 \
    -H 'Accept: application/vnd.github+json' \
    https://api.github.com/repos/LuisAlejandro/mash/releases/latest 2>/dev/null)" || return 1
  candidate="$(printf '%s' "$body" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("tag_name", "").strip().lstrip("vV"))
except Exception:
    pass' 2>/dev/null)"
  [ -n "$candidate" ] || return 1
  mash_version_gt "$candidate" "$installed"
}

# Whether the bundle this helper runs from can be replaced in place: it must be
# an .app whose parent accepts a write, which rules out a read-only DMG mount
# and a dist tree. A location we cannot swap still gets the notice, without the
# update key.
mash_macos_app() {
  local root
  root="$(cd "$res/../.." 2>/dev/null && pwd)" || return 1
  case "$root" in
  *.app) ;;
  *) return 1 ;;
  esac
  app="$root"
  [ -w "$(dirname "$root")" ] || return 1
  # An ad-hoc developer build has no Team ID to compare with the release,
  # so it cannot pass the verification gate and must not offer an update key.
  local team
  team="$(codesign -dv "$root" 2>&1 | sed -n 's/^TeamIdentifier=//p' | head -n 1)"
  [ -n "$team" ] && [ "$team" != "not set" ]
}

mash_show_notice() {
  local title body command herdr
  if [ "$entrypoint" = updated ]; then
    title="Mash updated to $installed"
    body="Mash is running the new version."
  elif [ "$system" = Darwin ]; then
    title="Mash $candidate is available"
    body="You have $installed. Open Mash to update."
  else
    command="sudo apt install --only-upgrade letsmash"
    title="Mash $candidate is available"
    body="You have $installed. To upgrade, run: $command"
  fi

  # Desktop notification. On Linux notify-send (libnotify-bin) is not
  # guaranteed; gdbus ships with Ubuntu desktop. On macOS use Mash's wrapper.
  if [ "$system" = Darwin ]; then
    [ -x "$res/bin/mash-notify" ] &&
      "$res/bin/mash-notify" -title "$title" -message "$body" >/dev/null 2>&1
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=Mash "$title" "$body" >/dev/null 2>&1
  elif command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.Notify \
      Mash 0 '' "$title" "$body" '[]' '{}' 5000 >/dev/null 2>&1
  fi

  # The popup is client-side: wait for the server and a brief attach grace.
  herdr="$res/bin/herdr"
  [ -x "$herdr" ] || return 0
  for _ in $(seq 1 50); do
    "$herdr" status server 2>/dev/null | grep -q 'status: running' && break
    sleep 0.2
  done
  sleep 2
  local width=56 height=9
  if [ "$entrypoint" = update ]; then
    width=64
    height=16
  fi
  "$herdr" plugin pane open --plugin mash-update-notice --entrypoint "$entrypoint" \
    --placement popup --width "$width" --height "$height" --focus \
    --env "MASH_UPDATE_INSTALLED=$installed" \
    --env "MASH_UPDATE_CANDIDATE=$candidate" \
    --env "MASH_UPDATE_CAN_APPLY=$can_apply" \
    --env "MASH_UPDATE_APP=$app" \
    --env "MASH_UPDATE_DATA=$d" >/dev/null 2>&1 || true
}

# --- decide --------------------------------------------------------------------
installed=""
candidate=""
app=""
can_apply=0
entrypoint=notice

# If power was lost after confirmation, compare the version that was about to
# install with the one that actually runs now. A crash before or after the
# atomic exchange leaves a complete app at the destination in either case.
if [ "$system" = Darwin ] && [ -f "$state/update-pending" ]; then
  mash_take_lock || exit 0
  pending="$(mash_read_line "$state/update-pending")"
  running="$(mash_read_line "$res/VERSION")"
  rm -f "$state/update-pending"
  if [ -n "$pending" ] && [ "$pending" = "$running" ]; then
    mash_write "$state/update-success" "$pending"
  else
    if [ -n "$pending" ] && [ "$(mash_read_line "$record")" = "$pending" ]; then
      rm -f "$record"
      mash_write "$state/update-retry" "$pending"
    fi
    [ -x "$res/bin/mash-notify" ] &&
      "$res/bin/mash-notify" -title "Mash update failed" \
        -message "The previous version remains installed. Open Mash to retry." >/dev/null 2>&1
  fi
  rm -rf "$lock"
fi

# The swap helper writes one success marker just before reopening Mash. The
# first attached window consumes it under the same lock used for announcements,
# proving the newly running version without making a network request.
if [ "$system" = Darwin ] && [ -f "$state/update-success" ]; then
  mash_take_lock || exit 0
  installed="$(mash_read_line "$res/VERSION")"
  if [ -n "$installed" ] && [ "$(mash_read_line "$state/update-success")" = "$installed" ]; then
    rm -f "$state/update-success"
    # Installing is already proof of the latest version; do not immediately
    # re-query GitHub in another window while this confirmation is displayed.
    mash_write "$checked" "$(date +%s)"
    rm -rf "$lock"
    entrypoint=updated
    candidate="$installed"
    mash_show_notice
    exit 0
  fi
  rm -rf "$lock"
fi

case "$system" in
Linux)
  mash_linux_candidate || exit 0
  ;;
Darwin)
  entrypoint=update
  # The lock is taken early here: the rate-limit window is read and written
  # inside it, so concurrent windows make one request between them.
  mash_take_lock || exit 0
  # A failed attempt is eligible again on the next launch, without making a
  # second GitHub request inside the 24-hour check window.
  installed="$(mash_read_line "$res/VERSION")"
  retry="$(mash_read_line "$state/update-retry")"
  rm -f "$state/update-retry"
  if [ -n "$retry" ] && mash_version_gt "$retry" "$installed"; then
    candidate="$retry"
  elif ! mash_macos_candidate; then
    rm -rf "$lock"
    exit 0
  fi
  mash_macos_app && can_apply=1
  ;;
*) exit 0 ;;
esac

# --- claim ---------------------------------------------------------------------
# Linux has not taken the lock yet; macOS already holds it.
if [ "$system" != Darwin ]; then
  mash_take_lock || exit 0
fi
if [ "$(cat "$record" 2>/dev/null)" = "$candidate" ]; then
  rm -rf "$lock"
  exit 0
fi
mash_write "$record" "$candidate"
rm -rf "$lock"

# --- announce ------------------------------------------------------------------
mash_show_notice
exit 0
