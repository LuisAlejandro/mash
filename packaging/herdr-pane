#!/bin/bash
# What Ghostty runs. Starts the bundled herdr on Mash's socket.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"
home="$(mash_real_home)"
bin_dir="$(cd "$(dirname "$0")" && pwd)"
res="$(cd "$bin_dir/.." && pwd)"
export MASH_BIN="$bin_dir:$res/node/bin:$res/python/bin:$home/.mash/bin"
# First-open setup. It is the only way to reach Herdr until it finishes: an
# unfinished setup leaves no providers, no Penpot account and no git identity,
# and Herdr would then open on top of that as if Mash were ready. The wizard
# exits 0 once setup is done, and on every later launch it returns 0 at once
# without touching the terminal.
#
# Exit 3 means the user chose to quit setup: Herdr stays closed. Any other
# failure (no terminal, an installer error, a wizard bug) still opens Mash, as
# it always did, so a broken wizard can never lock the user out; the setup
# reopens on the next launch because it never recorded completion.
if [ -x "$bin_dir/mash-wizard" ]; then
  status=0
  "$bin_dir/mash-wizard" || status=$?
  if [ "$status" = 3 ]; then
    printf '\n  Mash setup is not finished, so Mash did not open.\n'
    printf '  Open Mash again to start setup from the beginning.\n\n'
    printf '  Press Enter to close this window. '
    read -r _ || true
    exit 0
  fi
fi
# Which instance this window is. Set already (a relaunch inside a pane, or a
# launcher that chose one) means take it as given; otherwise claim the first
# instance that has no live window.
#
# "Has a live window" cannot be "its server is running": a Herdr server
# deliberately outlives its window, so after closing the last window the server
# is still up with the workspaces loaded -- which is exactly the instance a
# click should reattach to. The marker is therefore this script's own pid,
# written below, and a pid that is gone means the instance is free.
if [ -z "${MASH_INSTANCE:-}" ]; then
  MASH_INSTANCE="$(mash_claim_instance "$home" "$$")"
fi
export MASH_INSTANCE
mash_isolate "$home"
case "$HERDR_SOCKET_PATH" in
"$home/.mash/run/herdr.sock" | "$home/.mash/run/$MASH_INSTANCE/herdr.sock") ;;
*)
  echo "Mash refused to start." >&2
  exit 1
  ;;
esac
# The claim is only a reservation until here: mash_isolate has now created the
# instance's run directory, so the marker can be written where the next claim
# will look for it. Removed when this window exits, so the instance frees up
# without waiting for the pid check.
mash_mark_instance_window "$home" "$MASH_INSTANCE" "$$"
trap 'mash_release_instance_window "$home" "$MASH_INSTANCE" "$$"' EXIT HUP INT TERM
# Start design work only after the wizard saves its choice. Both macOS and
# Linux launch through this pane entry, so the first opted-in launch works too.
# mds start can pull/build images; keep it off the window's critical path. It
# also performs pending Penpot account setup, so never race it with that helper.
if [ -f "$home/.mash/config/mash/design-autostart" ] &&
  [ -x "$bin_dir/mash-design-autostart" ]; then
  nohup "$bin_dir/mash-design-autostart" "$home/.mash" </dev/null >/dev/null 2>&1 &
elif [ -f "$home/.mash/local/share/mash/design/penpot.env" ] &&
  [ -x "$bin_dir/mash-penpot-account-setup" ]; then
  # When not opted in, keep the existing account-creation retry behaviour.
  nohup "$bin_dir/mash-penpot-account-setup" "$home/.mash" </dev/null >/dev/null 2>&1 &
fi

# A leftover socket is removed only here, and only when nothing is using it.
if [ -S "$HERDR_SOCKET_PATH" ] && command -v lsof >/dev/null 2>&1; then
  if ! lsof "$HERDR_SOCKET_PATH" >/dev/null 2>&1; then
    rm -f "$HERDR_SOCKET_PATH"
  fi
fi
exec "$(dirname "$0")/herdr"
