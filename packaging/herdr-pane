#!/bin/bash
# What Ghostty runs. Starts the bundled herdr on Mash's socket.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"
home="$(mash_real_home)"
bin_dir="$(cd "$(dirname "$0")" && pwd)"
res="$(cd "$bin_dir/.." && pwd)"
export MASH_BIN="$bin_dir:$res/node/bin:$res/python/bin:$home/.mash/bin"

# First-open setup. It is the only way to reach Herdr until it finishes: an
# unfinished setup leaves no providers and no git identity,
# and Herdr would then open on top of that as if Mash were ready. The wizard
# exits 0 once setup is done, and on every later launch it returns 0 at once
# without touching the terminal.
#
# Exit 3 means the user chose to quit setup: Herdr stays closed. Any other
# failure (no terminal, an installer error, a wizard bug) still opens Mash, as
# it always did, so a broken wizard can never lock the user out; the setup
# reopens on the next launch because it never recorded completion.
if [ -x "$bin_dir/mash-wizard" ]; then
  status=0
  "$bin_dir/mash-wizard" || status=$?
  if [ "$status" = 3 ]; then
    printf '\n  %s\n' "$(PATH="$bin_dir:$res/python/bin:$PATH" MASH_LANGUAGE="$(mash_language_code "$home/.mash" 2>/dev/null || true)" MASH_I18N_DIR="$res/i18n" mash-t helper.setup.not_finished 2>/dev/null || printf '%s' 'Mash setup is not finished, so Mash did not open.')"
    printf '  %s\n\n' "$(PATH="$bin_dir:$res/python/bin:$PATH" MASH_LANGUAGE="$(mash_language_code "$home/.mash" 2>/dev/null || true)" MASH_I18N_DIR="$res/i18n" mash-t helper.setup.open_again 2>/dev/null || printf '%s' 'Open Mash again to start setup from the beginning.')"
    printf '  %s ' "$(PATH="$bin_dir:$res/python/bin:$PATH" MASH_LANGUAGE="$(mash_language_code "$home/.mash" 2>/dev/null || true)" MASH_I18N_DIR="$res/i18n" mash-t helper.setup.press_enter 2>/dev/null || printf '%s' 'Press Enter to close this window.')"
    read -r _ || true
    exit 0
  fi
fi
mash_isolate "$home"
case "$HERDR_SOCKET_PATH" in
"$home/.mash/run/herdr.sock") ;;
*)
  printf '%s\n' "$(PATH="$bin_dir:$res/python/bin:$PATH" MASH_LANGUAGE="$(mash_language_code "$home/.mash" 2>/dev/null || true)" MASH_I18N_DIR="$res/i18n" mash-t helper.launch.refused_start 2>/dev/null || printf '%s' 'Mash refused to start.')" >&2
  exit 1
  ;;
esac
# Reconcile before agents can connect, including migrating older header commands
# that could borrow the personal keychain. This is local configuration work;
# the helper never asks gh for credentials or contacts GitHub.
if [ -x "$bin_dir/mash-github-mcp" ]; then
  "$bin_dir/mash-github-mcp" "$home/.mash" </dev/null >/dev/null 2>&1 || true
fi

# Readiness belongs to the target GUI and its new server, not the installed
# VERSION file. This helper does not delay starting Herdr and has a deadline.
if [ "$(uname -s)" = Darwin ] && [ -x "$bin_dir/mash-update-gate" ] && [ -n "${MASH_TERMINAL_PID:-}" ]; then
  "$bin_dir/mash-update-gate" server-ready "$(cd "$res/../.." && pwd)" "$home/.mash" "$MASH_TERMINAL_PID" </dev/null >/dev/null 2>&1 &
fi

# A newer version is announced once per release: the local APT cache on Linux,
# the rate-limited GitHub release check on macOS. The helper waits for this
# window's server itself, so it never delays the window.
if [ -x "$bin_dir/mash-update-notice" ]; then
  nohup "$bin_dir/mash-update-notice" "$res" "$home/.mash" </dev/null >/dev/null 2>&1 &
fi

# Setup runs once, so without this a raised pin would only ever reach new
# installations. The helper re-asserts the pinned version of the tools Mash
# already installed here, and no-ops when they match -- which is the usual
# case. Backgrounded: a launch must never wait on it, nor fail with it.
if [ -x "$bin_dir/mash-tool-refresh" ]; then
  nohup "$bin_dir/mash-tool-refresh" "$home/.mash" </dev/null >/dev/null 2>&1 &
fi

# First handoff after setup only: the wizard leaves a one-shot marker, and the
# new-workspace popup opens as soon as the server answers. The marker is taken
# (renamed) before waiting, so the popup opens once.
once="$home/.mash/setup/open-workspace-once"
if mv "$once" "$once.taken" 2>/dev/null; then
  rm -f "$once.taken"
  # This terminal read its config before setup ran, so it is still on the
  # Cursor-style keymap and menus even when the wizard just chose Native.
  # SIGUSR2 is the terminal's own config-reload signal, and MASH_TERMINAL_PID
  # names the exact process that owns this pane, so no other window is touched.
  if [ -n "${MASH_TERMINAL_PID:-}" ]; then
    kill -USR2 "$MASH_TERMINAL_PID" 2>/dev/null || true
  fi
  (
    for _ in $(seq 1 50); do
      sleep 0.2
      "$bin_dir/herdr" plugin action invoke herdr-workspace.open >/dev/null 2>&1 && exit 0
    done
  ) </dev/null >/dev/null 2>&1 &
fi

# A leftover socket is removed only here, and only when nothing is using it.
if [ -S "$HERDR_SOCKET_PATH" ] && command -v lsof >/dev/null 2>&1; then
  if ! lsof "$HERDR_SOCKET_PATH" >/dev/null 2>&1; then
    rm -f "$HERDR_SOCKET_PATH"
  fi
fi
exec "$(dirname "$0")/herdr"
