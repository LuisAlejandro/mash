+
+// attention reports whether any pane of the tab holds an agent that needs the
+// user: one waiting on an answer, a confirmation or an approval, and one that
+// finished a turn nobody has looked at yet. Herdr names no constant for the
+// finished state, because none of the states it names changes a title.
+func attention(tab state.TabState) bool {
+	for _, pane := range tab.Panes {
+		switch pane.AgentStatus {
+		case herdr.AgentStatusBlocked, agentStatusDone:
+			return true
+		}
+	}
+
+	return false
+}
