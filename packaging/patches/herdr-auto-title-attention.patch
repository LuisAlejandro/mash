diff --git a/internal/app/attention_test.go b/internal/app/attention_test.go
new file mode 100644
index 0000000..e69c08f
--- /dev/null
+++ b/internal/app/attention_test.go
@@ -0,0 +1,78 @@
+package app
+
+import (
+	"testing"
+
+	"github.com/rivo/uniseg"
+
+	"github.com/kryptamine/herdr-auto-title/internal/herdr"
+	"github.com/kryptamine/herdr-auto-title/internal/state"
+)
+
+// titled is one tab of a session under the settings Mash ships, named by the
+// resolvers the app actually uses.
+func titled(t *testing.T, status, name string) string {
+	t.Helper()
+
+	titles, _, _ := resolvers(Config{
+		MaxLength:       50,
+		ShowPosition:    true,
+		ShowAgentStatus: true,
+	})
+
+	pane := &state.PaneState{ID: "w5:p1", Dir: "/w/" + name}
+	tab := state.TabState{
+		ID:          "w5:t8",
+		Position:    8,
+		Panes:       []*state.PaneState{pane},
+		Context:     pane,
+		AgentStatus: status,
+	}
+
+	return titles.Resolve(tab).Name
+}
+
+func TestATabThatNeedsTheUserIsMarkedInFrontOfItsPosition(t *testing.T) {
+	for _, tc := range []struct {
+		status string
+		want   string
+	}{
+		{herdr.AgentStatusBlocked, "● 8 · mash"},
+		{herdr.AgentStatusDone, "● 8 · mash"},
+		// Nothing is waiting on the user in these, so the tab reads as it did:
+		// the position, then the name.
+		{herdr.AgentStatusIdle, "8 · mash"},
+		{herdr.AgentStatusWorking, "8 · mash"},
+		{"unknown", "8 · mash"},
+		{"", "8 · mash"},
+	} {
+		if got := titled(t, tc.status, "mash"); got != tc.want {
+			t.Errorf("status %q: got %q, want %q", tc.status, got, tc.want)
+		}
+	}
+}
+
+// The mark is counted against the same bound as everything else, so a marked
+// tab is never wider than an unmarked one, and the mark costs the name exactly
+// its own columns.
+func TestTheMarkCostsTheNameItsWidth(t *testing.T) {
+	long := "0123456789012345678901234567890123456789012345678901234567890"
+	const mark = "● "
+
+	plain := titled(t, herdr.AgentStatusIdle, long)
+	marked := titled(t, herdr.AgentStatusBlocked, long)
+
+	for _, name := range []string{plain, marked} {
+		if width := uniseg.StringWidth(name); width != 50 {
+			t.Fatalf("%q is %d columns, want the bound of 50", name, width)
+		}
+	}
+
+	plainName := plain[len("8 · "):]
+	markedName := marked[len("● 8 · "):]
+
+	if lost := uniseg.StringWidth(plainName) - uniseg.StringWidth(markedName); lost != uniseg.StringWidth(mark) {
+		t.Fatalf("the mark took %d columns of name, want %d: %q vs %q",
+			lost, uniseg.StringWidth(mark), marked, plain)
+	}
+}
