@@ -0,0 +1,66 @@
+package resolver
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/rivo/uniseg"
+
+	"github.com/kryptamine/herdr-auto-title/internal/herdr"
+	"github.com/kryptamine/herdr-auto-title/internal/state"
+)
+
+// fixed names every tab the same way, so these cases are about the marks the
+// numbered resolver puts around a name and nothing else.
+type fixed struct{ name string }
+
+func (f fixed) Resolve(state.TabState) Decision { return Decision{Name: f.name} }
+
+// tab is position eight holding one pane whose agent is in status.
+func tab(status string) state.TabState {
+	return state.TabState{
+		Position: 8,
+		Panes:    []*state.PaneState{{ID: "w1:p1", AgentStatus: status}},
+	}
+}
+
+func TestAnAgentThatNeedsTheUserMarksItsTab(t *testing.T) {
+	numbered := NewNumbered(fixed{"mash"}, 50)
+
+	for _, tc := range []struct {
+		status string
+		want   string
+	}{
+		{herdr.AgentStatusBlocked, "● 8 · mash"},
+		{"done", "● 8 · mash"},
+		// Nothing is waiting on the user in these, so the tab stays unmarked.
+		{herdr.AgentStatusWorking, "8 · mash"},
+		{"idle", "8 · mash"},
+		{"unknown", "8 · mash"},
+		{"", "8 · mash"},
+	} {
+		if got := numbered.Resolve(tab(tc.status)).Name; got != tc.want {
+			t.Errorf("status %q: got %q, want %q", tc.status, got, tc.want)
+		}
+	}
+}
+
+// The mark is a prefix, not something added on top: a marked tab is as wide as
+// an unmarked one and the mark costs the name its own width.
+func TestTheMarkCostsTheNameItsWidth(t *testing.T) {
+	numbered := NewNumbered(fixed{strings.Repeat("x", 60)}, 50)
+
+	plain := numbered.Resolve(tab("idle")).Name
+	marked := numbered.Resolve(tab(herdr.AgentStatusBlocked)).Name
+
+	if width := uniseg.StringWidth(marked); width != 50 {
+		t.Fatalf("marked title is %d columns, want the bound of 50: %q", width, marked)
+	}
+
+	plainName := strings.TrimPrefix(plain, "8 · ")
+	markedName := strings.TrimPrefix(marked, attentionMark+"8 · ")
+	if lost := len(plainName) - len(markedName); lost != len([]rune(attentionMark)) {
+		t.Fatalf("mark cost %d columns of name, want %d: %q vs %q",
+			lost, len([]rune(attentionMark)), marked, plain)
+	}
+}
