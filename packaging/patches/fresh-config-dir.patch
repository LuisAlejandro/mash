+    /// Absolute config or data directory from a Mash variable.
+    /// Unset keeps the upstream path. A relative value is rejected.
+    fn mash_dir(name: &str) -> std::io::Result<Option<std::path::PathBuf>> {
+        match std::env::var(name) {
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(err) => Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, err)),
+            Ok(value) => {
+                let path = std::path::PathBuf::from(&value);
+                if path.is_absolute() {
+                    Ok(Some(path))
+                } else {
+                    Err(std::io::Error::new(
+                        std::io::ErrorKind::InvalidInput,
+                        format!("{name} must be an absolute path"),
+                    ))
+                }
+            }
+        }
+    }
