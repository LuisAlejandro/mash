+/// The explorer's copy/cut state sits on the window that made it, and Mash runs
+/// one `fresh` process per terminal tab — so a copy in one tab made a paste in
+/// another report "Nothing to paste". The clipboard is now mirrored into the
+/// data directory. Two harnesses sharing nothing but that directory stand in
+/// for two processes: no in-memory state crosses between them.
+#[test]
+fn test_explorer_clipboard_pastes_into_a_second_editor() {
+    let sandbox = tempfile::tempdir().unwrap();
+    let (dir_context, _data_dir_pin) = isolated_dir_context(sandbox.path());
+    let project = sandbox.path().join("project");
+    fs::create_dir_all(project.join("dst")).unwrap();
+    fs::write(project.join("moved.txt"), "payload").unwrap();
+    let project = project.canonicalize().unwrap();
+    let config = Config {
+        check_for_updates: false,
+        ..Config::default()
+    };
+
+    // First editor: copy `moved.txt` and leave without pasting, so the mirror
+    // is the only thing that can carry the copy across.
+    {
+        let mut first = EditorTestHarness::with_shared_dir_context(
+            100,
+            30,
+            config.clone(),
+            project.clone(),
+            dir_context.clone(),
+        )
+        .unwrap();
+        first.editor_mut().focus_file_explorer();
+        first.wait_for_file_explorer().unwrap();
+        first.wait_for_file_explorer_item("moved.txt").unwrap();
+        // Directories sort first: root → dst/ → moved.txt.
+        first.send_key(KeyCode::Down, KeyModifiers::NONE).unwrap();
+        first.send_key(KeyCode::Down, KeyModifiers::NONE).unwrap();
+        first
+            .send_key(KeyCode::Char('c'), KeyModifiers::CONTROL)
+            .unwrap();
+        first.render().unwrap();
+        // Name the selection: if the arrows landed anywhere else, the copy
+        // silently stashes a different path and the paste below fails for a
+        // reason that has nothing to do with the mirror.
+        first.assert_screen_contains("Copied: moved.txt");
+    }
+
+    // Second editor: paste into dst/.
+    let mut second = EditorTestHarness::with_shared_dir_context(
+        100,
+        30,
+        config,
+        project.clone(),
+        dir_context.clone(),
+    )
+    .unwrap();
+    second.editor_mut().focus_file_explorer();
+    second.wait_for_file_explorer().unwrap();
+    second.wait_for_file_explorer_item("dst").unwrap();
+    second.send_key(KeyCode::Down, KeyModifiers::NONE).unwrap();
+    second
+        .send_key(KeyCode::Char('v'), KeyModifiers::CONTROL)
+        .unwrap();
+    second.render().unwrap();
+
+    assert!(
+        project.join("dst/moved.txt").exists(),
+        "a copy made in the first editor must be pasteable in the second. \
+         Project now: {:?}",
+        fs::read_dir(project.join("dst"))
+            .map(|entries| entries
+                .filter_map(|e| e.ok().map(|e| e.file_name()))
+                .collect::<Vec<_>>())
+            .unwrap_or_default()
     );
+    assert!(
+        project.join("moved.txt").exists(),
+        "a copy must leave its source in place"
+    );
 }
