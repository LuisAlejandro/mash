+
+// Modified by Mash on 2026-10-31: mirror the file-explorer clipboard into the
+// data directory, so a copy/cut made in one `fresh` process (Mash runs one per
+// terminal tab) can be pasted in another. Mash source:
+// packaging/patches/fresh-explorer-clipboard.patch
+
+/// On-disk shape of [`FileExplorerClipboard`]. Separate from the in-memory type
+/// so the published fields do not become a serialization contract.
+#[derive(serde::Deserialize, serde::Serialize)]
+struct PersistedFileExplorerClipboard {
+    paths: Vec<PathBuf>,
+    is_cut: bool,
+}
+
+/// Where the file-explorer clipboard is mirrored so it outlives this process.
+///
+/// The clipboard lives on the `Window` that made it, and with one `fresh`
+/// process per terminal tab a copy in one tab is invisible to a paste in
+/// another — "Nothing to paste". Mirroring the same `{paths, is_cut}` into the
+/// data directory makes it a property of the user, which is what a file
+/// clipboard is: Finder, and every editor that has one, behave that way. The
+/// window slot stays authoritative; this file only answers when it is empty.
+fn explorer_clipboard_file() -> Option<PathBuf> {
+    crate::input::input_history::get_data_dir()
+        .ok()
+        .map(|dir| dir.join("file-explorer-clipboard.json"))
+}
+
+/// Mirror a copy/cut for other `fresh` processes. Best effort: a read-only data
+/// directory must never turn a copy into an error.
+fn persist_explorer_clipboard(clipboard: &FileExplorerClipboard) {
+    let Some(path) = explorer_clipboard_file() else {
+        return;
+    };
+    let payload = PersistedFileExplorerClipboard {
+        paths: clipboard.paths.clone(),
+        is_cut: clipboard.is_cut,
+    };
+    let Ok(encoded) = serde_json::to_vec(&payload) else {
+        return;
+    };
+    if let Some(parent) = path.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    // Write then rename: another process may read this at the same moment, and
+    // a half-written file would decode as "no clipboard".
+    let staging = path.with_extension("json.tmp");
+    if std::fs::write(&staging, encoded).is_ok() {
+        let _ = std::fs::rename(&staging, &path);
+    }
+}
+
+/// Read the mirrored clipboard, dropping paths that have since disappeared. A
+/// stale cut whose source is gone must not resurface as a paste that
+/// half-works.
+fn load_persisted_explorer_clipboard() -> Option<FileExplorerClipboard> {
+    let encoded = std::fs::read(explorer_clipboard_file()?).ok()?;
+    let payload: PersistedFileExplorerClipboard = serde_json::from_slice(&encoded).ok()?;
+    let paths: Vec<PathBuf> = payload.paths.into_iter().filter(|p| p.exists()).collect();
+    if paths.is_empty() {
+        return None;
+    }
+    Some(FileExplorerClipboard {
+        paths,
+        is_cut: payload.is_cut,
+    })
+}
+
+/// Drop the mirror. Called wherever the window's own slot is cleared, so a cut
+/// that already moved its file cannot be replayed from another tab.
+fn clear_persisted_explorer_clipboard() {
+    if let Some(path) = explorer_clipboard_file() {
+        let _ = std::fs::remove_file(path);
+    }
 }
 
