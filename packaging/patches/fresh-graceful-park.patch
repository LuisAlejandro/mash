+// Modified by Mash, 2026-11-19: parking terminates the client, not the daemon.
+static DETACH_REQUESTED: AtomicBool = AtomicBool::new(false);
+
+pub fn setup_detach_handler() -> io::Result<()> {
+    use nix::sys::signal::{signal, SigHandler, Signal};
+
+    extern "C" fn request_detach(_: libc::c_int) {
+        DETACH_REQUESTED.store(true, Ordering::Relaxed);
+    }
+
+    // SAFETY: the handler only stores to a lock-free atomic. Terminal cleanup
+    // runs on the relay's normal exit path, never in the signal handler.
+    unsafe { signal(Signal::SIGTERM, SigHandler::Handler(request_detach)) }?;
+    Ok(())
+}
