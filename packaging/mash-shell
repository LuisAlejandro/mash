#!/bin/bash
# Herdr's pane shell. Re-applies Mash's socket, then starts the account's shell
# without login so the user's startup files and the system path helper do not run.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"
here="$(cd "$(dirname "$0")" && pwd)"
home="$(mash_real_home)"
# MASH_BIN is AUGMENTED, never replaced. Herdr starts this script with the
# environment herdr-pane built, and that value names every Mash program
# directory: Resources/bin, Resources/node/bin, Resources/python/bin. Setting it
# to this script's own directory alone dropped the bundle from the variable, so
# the bundled pi, node and python3 stayed on PATH only because the inherited
# PATH still happened to hold them -- while mash_isolate pins MASH_BIN to the
# front, where losing it means a host twin wins instead.
export MASH_BIN="${MASH_BIN:+$MASH_BIN:}$here:$home/.mash/bin"
mash_isolate "$home" pane
export MASH_PANE=1
# A scripted dev tab can start Fresh before the interactive shell initializes
# Starship and prints a prompt. Keep the wrapper: it sets right-click routing
# and reports the resume command. On exit (or launch failure), open the usual
# shell; unset the one-shot flag so it cannot leak into that shell.
if [ "${MASH_DEV_TAB_FRESH:-}" = 1 ]; then
  unset MASH_DEV_TAB_FRESH
  herdr-fresh-pane . || true
fi
# MASH_USER_SHELL stands in for the account's shell in tests, so the branch
# below can be exercised without a pty or a second account.
user_shell="${MASH_USER_SHELL:-$(mash_real_shell)}"
# Every shell starts in Mash's own startup, never the account's:
#   zsh  -- ZDOTDIR points at Mash's config directory, which ships .zshenv and
#           .zshrc and no user files. /etc/zshrc still runs (zsh has no flag to
#           skip it).
#   fish -- XDG_CONFIG_HOME points at Mash's config directory, which ships
#           fish/config.fish. /etc/fish/config.fish still runs on Linux.
#   bash -- has neither variable, so it is started with --rcfile naming Mash's
#           bashrc; that file is what /etc/bash.bashrc (where the build has one)
#           would otherwise precede. --norc is the fallback for a data folder
#           seeded before this file existed.
# The point is not just isolation: a ~/.bashrc that prepends ~/.local/bin or
# /opt/homebrew/bin runs after isolation and puts a host pi back in front of the
# bundled one. Each rc re-prepends MASH_BIN so that cannot happen.
case "$(basename -- "$user_shell")" in
bash)
	# Relative to this script, not to $home: mash-shell is copied to $d/bin by the
	# launcher, so $d is one level up and the startup file sits beside it. Using
	# the script's own location keeps this right even when the account's home
	# comes from the directory service rather than $HOME.
	rc="$(cd "$here/.." && pwd)/config/bash/bashrc"
	if [ -f "$rc" ]; then
		exec "$user_shell" --rcfile "$rc"
	fi
	exec "$user_shell" --norc
	;;
*) exec "$user_shell" ;;
esac
