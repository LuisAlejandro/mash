#!/bin/bash
# Mash.app entry point. Opens the bundled Ghostty and Herdr.
# Does not export HOME and does not talk to the personal Herdr socket.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib.sh
source "$ROOT/Resources/bin/lib.sh"

home="$(mash_real_home)"
d="$home/.mash"
mkdir -p \
    "$d/.config/herdr" "$d/.config/ghostty" "$d/.config/git" "$d/.config/gh" \
    "$d/.config/fresh" "$d/.config/zsh" "$d/.config/pet" "$d/.config/atuin" \
    "$d/.config/lazygit" "$d/.config/lazydocker" "$d/.config/mash" \
    "$d/.local/state" "$d/.local/share/fresh" "$d/.local/share/zoxide" \
    "$d/.cache" "$d/.pi/agent" "$d/run" "$d/bin"

cp "$ROOT/Resources/bin/lib.sh" "$d/bin/lib.sh"
cp "$ROOT/Resources/bin/mash-shell" "$d/bin/mash-shell"
chmod 755 "$d/bin/mash-shell"

if [ ! -f "$d/.config/herdr/config.toml" ]; then
    sed -e "s#__MASH_SHELL__#$d/bin/mash-shell#g" \
        -e "s#__MASH_CONFIG__#$d/.config#g" \
        "$ROOT/Resources/defaults/herdr/config.toml" \
        >"$d/.config/herdr/config.toml"
fi
if [ ! -f "$d/.config/herdr/plugins.json" ] && [ -f "$ROOT/Resources/defaults/herdr/plugins.json" ]; then
    cp "$ROOT/Resources/defaults/herdr/plugins.json" "$d/.config/herdr/plugins.json"
fi
if [ ! -f "$d/.config/ghostty/config" ]; then
    cp "$ROOT/Resources/defaults/ghostty/config" "$d/.config/ghostty/config"
fi
if [ ! -f "$d/.config/zsh/.zshenv" ]; then
    cp "$ROOT/Resources/defaults/zsh/.zshenv" "$d/.config/zsh/.zshenv"
fi
if [ ! -f "$d/.config/git/config" ]; then
    cp "$ROOT/Resources/defaults/git/config" "$d/.config/git/config"
fi
if [ ! -f "$d/.config/pet/snippet.toml" ]; then
    sed "s#__MASH_PET_SNIPPET__#$d/.config/pet/snippet.toml#" \
        "$ROOT/Resources/defaults/pet/config.toml" \
        >"$d/.config/pet/config.toml"
    cp "$ROOT/Resources/defaults/pet/snippet.toml" "$d/.config/pet/snippet.toml"
fi

# Copy each carried seed only when that destination file is missing.
mash_seed_missing() {
    local src="$1"
    local dest="$2"
    local f rel target
    [ -d "$src" ] || return 0
    while IFS= read -r f; do
        rel="${f#"$src"/}"
        target="$dest/$rel"
        if [ ! -e "$target" ]; then
            mkdir -p "$(dirname "$target")"
            cp "$f" "$target"
        fi
    done < <(find "$src" -type f)
}

# References and the mash-parallel venv live under ~/.mash/.config/mash.
# The venv's Python symlink is retargeted at this bundle. Existing files stay.
mash_seed_programming_skills() {
    local src venv py cfg current script
    src="$ROOT/Resources/defaults/mash-config"
    [ -d "$src" ] || return 0
    mash_seed_missing "$src/references" "$d/.config/mash/references"
    if [ ! -f "$d/.config/mash/hindsight-pin" ] && [ -f "$src/hindsight-pin" ]; then
        cp "$src/hindsight-pin" "$d/.config/mash/hindsight-pin"
    fi
    venv="$d/.config/mash/venvs/mash-parallel"
    if [ -d "$src/venvs/mash-parallel" ] && [ ! -e "$venv/pyvenv.cfg" ]; then
        mkdir -p "$d/.config/mash/venvs"
        cp -a "$src/venvs/mash-parallel" "$venv"
    fi
    py="$ROOT/Resources/python/bin/python3"
    if [ -d "$venv/bin" ] && [ -x "$py" ]; then
        current="$(readlink "$venv/bin/python" 2>/dev/null || true)"
        [ "$current" = "$py" ] || ln -sfn "$py" "$venv/bin/python"
        current="$(readlink "$venv/bin/python3" 2>/dev/null || true)"
        [ "$current" = "python" ] || ln -sfn python "$venv/bin/python3"
        if [ -L "$venv/bin/python3.13" ]; then
            current="$(readlink "$venv/bin/python3.13" 2>/dev/null || true)"
            [ "$current" = "python" ] || ln -sfn python "$venv/bin/python3.13"
        fi
        cfg="$venv/pyvenv.cfg"
        if [ -f "$cfg" ]; then
            awk -v homebin="$ROOT/Resources/python/bin" -v exe="$py" '
                BEGIN { h = 0; e = 0 }
                /^home[[:space:]]*=/ { print "home = " homebin; h = 1; next }
                /^executable[[:space:]]*=/ { print "executable = " exe; e = 1; next }
                { print }
                END {
                    if (!h) print "home = " homebin
                    if (!e) print "executable = " exe
                }
            ' "$cfg" >"$cfg.tmp"
            if cmp -s "$cfg.tmp" "$cfg"; then
                rm -f "$cfg.tmp"
            else
                mv "$cfg.tmp" "$cfg"
            fi
        fi
        PYTHONNOUSERSITE=1 "$py" - "$venv" <<'PY'
import os, sys
venv = sys.argv[1]
bindir = os.path.join(venv, "bin")
want = b"#!" + os.path.join(bindir, "python").encode() + b"\n"
for name in os.listdir(bindir):
    path = os.path.join(bindir, name)
    if os.path.islink(path) or not os.path.isfile(path):
        continue
    with open(path, "rb") as fh:
        data = fh.read()
    head, sep, tail = data.partition(b"\n")
    if not head.startswith(b"#!") or b"python" not in head:
        continue
    updated = want + tail
    if updated != data:
        with open(path, "wb") as fh:
            fh.write(updated)
PY
    fi
    script="$d/.pi/agent/skills/mash-parallel"
    if [ -d "$script" ] && [ -d "$venv" ] && [ ! -e "$script/.venv" ]; then
        ln -s "$venv" "$script/.venv"
    fi
}

mash_seed_missing "$ROOT/Resources/defaults/ghostty/themes" "$d/.config/ghostty/themes"
mash_seed_missing "$ROOT/Resources/defaults/fresh" "$d/.config/fresh"
mash_seed_missing "$ROOT/Resources/defaults/pi" "$d/.pi/agent"
mash_seed_missing "$ROOT/Resources/defaults/plugins" "$d/.config/herdr/plugins/config"
mash_seed_missing "$ROOT/Resources/defaults/atuin" "$d/.config/atuin"
mash_seed_missing "$ROOT/Resources/defaults/lazydocker" "$d/.config/lazydocker"
mash_seed_programming_skills

mash_force_updates "$home"
export MASH_BIN="$ROOT/Resources/bin:$ROOT/Resources/node/bin:$ROOT/Resources/python/bin:$d/bin"
mash_isolate "$home"

exec /usr/bin/open -na "$ROOT/Resources/Ghostty.app" \
    --env "XDG_CONFIG_HOME=$XDG_CONFIG_HOME" \
    --env "XDG_STATE_HOME=$XDG_STATE_HOME" \
    --env "XDG_DATA_HOME=$XDG_DATA_HOME" \
    --env "XDG_CACHE_HOME=$XDG_CACHE_HOME" \
    --env "HERDR_CONFIG_PATH=$HERDR_CONFIG_PATH" \
    --env "HERDR_SOCKET_PATH=$HERDR_SOCKET_PATH" \
    --env "HERDR_CLIENT_SOCKET_PATH=$HERDR_CLIENT_SOCKET_PATH" \
    --env "PI_CODING_AGENT_DIR=$PI_CODING_AGENT_DIR" \
    --env "GIT_CONFIG_GLOBAL=$GIT_CONFIG_GLOBAL" \
    --env "GH_CONFIG_DIR=$GH_CONFIG_DIR" \
    --env "_ZO_DATA_DIR=$_ZO_DATA_DIR" \
    --env "ZDOTDIR=$ZDOTDIR" \
    --env "MASH_FRESH_CONFIG_DIR=$MASH_FRESH_CONFIG_DIR" \
    --env "MASH_FRESH_DATA_DIR=$MASH_FRESH_DATA_DIR" \
    --env "MASH_BIN=$MASH_BIN" \
    --env "PATH=$PATH" \
    --args -e "$ROOT/Resources/bin/herdr-pane"
