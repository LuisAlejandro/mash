#!/bin/bash
# Mash.app entry point. Opens the bundled Ghostty and Herdr.
# Does not export HOME and does not talk to the personal Herdr socket.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib.sh
source "$ROOT/Resources/bin/lib.sh"
# Shared optional-suite selection and Pi copy filter (also used on Linux).
# shellcheck source=launch-common.sh
source "$ROOT/Resources/bin/launch-common.sh"
res="$ROOT/Resources"

home="$(mash_real_home)"
d="$home/.mash"
# 0700, not the umask's 0755: the data folder holds agent transcripts and logs
# written by tools Mash does not own, and +x on this directory is what gates
# every one of them. Runs on every launch so an existing 0755 install is fixed.
mash_protect_data_dir "$d"
# Nothing may grow inside the bundle after it is signed. The bundled
# interpreter is on every pane's PATH, and Python writes __pycache__ next to
# the module it imports -- the Hindsight daemon alone laid down 34 files in
# Resources/python/lib that way, which breaks the seal and fails
# `codesign --verify`. build.sh strips the bytecode the build itself creates;
# this stops it coming back. Forwarded to the panes below, which is where the
# long-lived interpreters actually run.
export PYTHONDONTWRITEBYTECODE=1
# Everything that fills ~/.mash lives in launch-common.sh, which the Linux
# launcher calls the same way: directory layout, the ownership reconcile, the
# generated configs, the seeded trees, the programming suite and Hindsight.
# This launcher used to carry its own copy of that sequence, which drifted --
# the shared one had gained the shell rc files, the Starship config, the tab
# bar's version substitution and the notifier config, and none of them reached
# macOS.
mash_seed_all "$ROOT/Resources" "$d" "$home"

mash_force_updates "$home"
export MASH_BIN="$ROOT/Resources/bin:$ROOT/Resources/node/bin:$ROOT/Resources/python/bin:$d/bin"
mash_isolate "$home"

# After mash_isolate: the shared mash_link_plugins reads XDG_CONFIG_HOME and
# XDG_DATA_HOME that it exports, and drops only the socket variables, so a
# running Herdr is never disturbed.
mash_link_plugins

# Belt and braces: `open --env` forwards only what is listed below, so these
# cannot leak today. Unsetting them states the requirement locally, so adding
# a socket line to that list cannot quietly pin every window to one instance.
unset HERDR_SOCKET_PATH HERDR_CLIENT_SOCKET_PATH HERDR_SESSION MASH_INSTANCE

# No instance is chosen here. The click opens a window, and the window's own
# herdr-pane claims the first instance with no live window: the restored one on
# the first click, a fresh empty one while that window is open. Choosing here
# instead would race two quick clicks through one launcher each, and would also
# miss windows opened from File > New Window, which run herdr-pane directly.
#
# MASH_INSTANCE is deliberately NOT forwarded below for the same reason: an
# inherited value would pin every window of this launch to one instance.
#
# The two socket variables are not forwarded either. mash_isolate set them to
# the default instance's paths for the setup above (plugin linking, the stale
# socket sweep), and forwarding them would hand every window that instance
# before its herdr-pane could claim a free one -- reinstating the clone. The
# window recomputes both from the instance it claims; every other variable
# below is instance-independent and is still forwarded.
exec /usr/bin/open -na "$ROOT/Resources/Mash Terminal.app" \
  --env "XDG_CONFIG_HOME=$XDG_CONFIG_HOME" \
  --env "XDG_STATE_HOME=$XDG_STATE_HOME" \
  --env "XDG_DATA_HOME=$XDG_DATA_HOME" \
  --env "XDG_CACHE_HOME=$XDG_CACHE_HOME" \
  --env "HERDR_CONFIG_PATH=$HERDR_CONFIG_PATH" \
  --env "PI_CODING_AGENT_DIR=$PI_CODING_AGENT_DIR" \
  --env "PI_HOME=$PI_HOME" \
  --env "npm_config_cache=$npm_config_cache" \
  --env "GIT_CONFIG_GLOBAL=$GIT_CONFIG_GLOBAL" \
  --env "GH_CONFIG_DIR=$GH_CONFIG_DIR" \
  --env "_ZO_DATA_DIR=$_ZO_DATA_DIR" \
  --env "ZDOTDIR=$ZDOTDIR" \
  --env "MASH_FRESH_CONFIG_DIR=$MASH_FRESH_CONFIG_DIR" \
  --env "MASH_FRESH_DATA_DIR=$MASH_FRESH_DATA_DIR" \
  --env "MASH_CONFIG_DIR=$MASH_CONFIG_DIR" \
  --env "PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH" \
  --env "MASH_BIN=$MASH_BIN" \
  --env "PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE" \
  --env "PATH=$PATH" \
  --args -e "$ROOT/Resources/bin/herdr-pane"
